	function hudState.TriggerShockingHit(dmg)
		if hudState.IsDefeated then return end
		hudState.LastHitTime = os.clock()
		local d = tonumber(dmg) or 10
		hudState.SpawnPopNumber(d)

		hitFlash.BackgroundTransparency = 0.2
		TweenService:Create(hitFlash, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 }):Play()

		local ringSpread = math.clamp(d * 2, 20, 60)
		shockRing.Size = UDim2.fromScale(1, 1)
		shockStroke.Transparency = 0
		TweenService:Create(shockRing, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			Size = UDim2.new(1, ringSpread, 1, ringSpread * 0.7)
		}):Play()
		TweenService:Create(shockStroke, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Transparency = 1
		}):Play()

		task.spawn(function()
			local base = hudState.BasePosition or root.Position
			local start = os.clock()
			local intensity = math.clamp(d * 0.6, 5, 14)
			while os.clock() - start < 0.26 do
				local ox = math.random(-intensity, intensity)
				local oy = math.random(-intensity * 0.7, intensity * 0.7)
				local rot = math.random(-2, 2)
				root.Position = UDim2.new(base.X.Scale, base.X.Offset + ox, base.Y.Scale, base.Y.Offset + oy)
				card.Rotation = rot
				task.wait(0.015)
			end
			root.Position = hudState.BasePosition or base
			card.Rotation = 0
		end)
	end

	function hudState.TriggerDefeat()
		if hudState.IsDefeated then return end
		hudState.IsDefeated = true

		slashSparks.BackgroundTransparency = 0
		ssGlow.Transparency = 0
		slashSparks.Rotation = -18
