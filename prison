local function triggerParry(eChar, retry)
	if not appAlive or not autoParryActive then return end
	local myChar = Players.LocalPlayer.Character
	local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 or myChar:GetAttribute("NG_Dead") == true or myChar:GetAttribute("NG_Knocked") == true then return end
	if not eChar or not eChar.Parent then return end
	local now = os.clock()
	local action = tonumber(eChar:GetAttribute("CombatActionToken"))
	if not action or action <= 0 or eChar:GetAttribute("CombatActionMove") == "" then action = nil end
	if not retry and parryInput.lastAttacker == eChar then
		if (action and action == parryInput.lastAction) or now - (parryInput.lastReportAt or -math.huge) < 0.08 then return end
	end
	if not retry and parryChance < 100 and math.random(1, 100) > parryChance then return end
	if not retry then parryInput.lastAttacker, parryInput.lastReportAt, parryInput.lastAction = eChar, now, action end
	local eHrp = eChar:FindFirstChild("HumanoidRootPart")
	if not eHrp then return end
	local controller = getCombatController()
	if controller and parryInput.manualSequence then
		if controller.blockRequestActive then return end
		parryInput.manualSequence = nil
	end
	local holdUntil = parryInput.holdDeadline(myChar, now)
	if parryInput.held and controller and parryInput.controller == controller then
		if controller.blockPressSequence ~= parryInput.sequence then
			parryInput.held = false
			parryInput.manualSequence = controller.blockPressSequence
			parryInput.pending = nil
			return
		end
		local serverNow = workspace:GetServerTimeNow()
		local rearmAt = math.max(tonumber(controller.defenseRearmAt) or 0, tonumber(myChar:GetAttribute("CombatDefenseRearmAt")) or 0)
		if controller.blockRequestActive ~= true or serverNow < rearmAt then
			parryInput.pending = nil
			parryInput.releaseAt = math.max(parryInput.releaseAt, holdUntil)
			parryInput.hardReleaseAt = now + math.max(parryHoldMs / 1000, 0.9)
			parryDiagnostic.merged += 1
			faceAttacker(eHrp)
			return
		end
	end
	if now < parryInput.nextBegin then
		parryInput.pending = {character = eChar, action = action, expires = now + 0.18}
		parryDiagnostic.queued += 1
		return
	end
	faceAttacker(eHrp)
	releaseParryInput()
	local ok, result, path, before
	if controller then
		path = "controller"
		before = controller.blockPressSequence
		ok, result = pcall(controller.onBlockAction, nil, Enum.UserInputState.Begin)
	else
		path = "keyboard"
		ok = pcall(function() VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game) end)
	end
	parryDiagnostic.attempts += 1
	parryInput.nextBegin = now + 0.08
	local accepted = ok and result ~= false
	if controller and type(before) == "number" then accepted = accepted and controller.blockPressSequence > before end
	if not accepted then
		if not ok then combatControllerTable = nil end
		parryDiagnostic.rejected += 1
		if not retry then parryInput.pending = {character = eChar, action = action, expires = now + 0.22} end
		return
	end
	parryInput.pending = nil
	parryInput.held, parryInput.controller, parryInput.path = true, controller, path
	parryInput.sequence = controller and controller.blockPressSequence
	parryInput.releaseAt = holdUntil
	parryInput.hardReleaseAt = now + math.max(parryHoldMs / 1000, 0.9)
	if legitBlockingAnimActive then
		parryInput.suppressBlockAnim()
	end
end

