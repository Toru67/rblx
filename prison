			TextTransparency = 1
		})
		local tweenBannerStroke = TweenService:Create(dbStroke, TweenInfo.new(fallDur * 0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Transparency = 1
		})

		tweenLeft:Play()
		tweenRight:Play()
		tweenBanner:Play()
		tweenBannerFade:Play()
		tweenBannerStroke:Play()

		task.wait(fallDur)
		if hudState.IsDefeated then
			sg.Enabled = false
			hudState.LastTarget = nil
		end
	end

	return hudState
end

local currentCombatTarget = nil
local currentCombatRole = "TARGET"
local lastCombatTargetTime = 0

local function setCombatTarget(plr, role)
	if not plr or plr == Players.LocalPlayer or not plr.Character then return end
	currentCombatTarget = plr
	currentCombatRole = role or "TARGET"
	lastCombatTargetTime = os.clock()
	if targetHudInstance then
		targetHudInstance.LastHitTime = os.clock()
		if targetHudInstance.IsDefeated and targetHudInstance.LastTarget ~= plr then
			targetHudInstance.Reset()
		end
	end
end

local function hookPlayerCombat(plr)
	if not plr or plr == Players.LocalPlayer then return end
	local function onChar(char)
		if not char then return end
		local hum = char:WaitForChild("Humanoid", 2) or char:FindFirstChildOfClass("Humanoid")
		local lastH = hum and hum.Health or 100
		if hum then
			local hConn = hum.HealthChanged:Connect(function(newH)
				if not appAlive or not targetHudActive then return end
				local diff = lastH - newH
				lastH = newH
				if diff > 0.2 then
					local lp = Players.LocalPlayer
					local myChar = lp and lp.Character
					local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
					local eHrp = char:FindFirstChild("HumanoidRootPart")
					local lastAttacker = char:GetAttribute("NG_LastAttackerId")
					local isAttackerMe = (lp and lastAttacker == lp.UserId)
					if isAttackerMe then
						setCombatTarget(plr, "TARGET")
					elseif myHrp and eHrp then
						local dist = (eHrp.Position - myHrp.Position).Magnitude
