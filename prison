local combatControllerTable = nil
local lastCombatControllerScan = -math.huge
local function hookCombatController(c)
	if not c or c._airCombatHooked then return end
	c._airCombatHooked = true
	if type(c.isCombatGrounded) == "function" then
		local rawGrounded = c.isCombatGrounded
		if type(hookfunction) == "function" then
			pcall(function()
				rawGrounded = hookfunction(c.isCombatGrounded, function(...)
					if airCombatActive then return true end
					return rawGrounded(...)
				end)
			end)
		end
		c.isCombatGrounded = function(...)
			if airCombatActive then return true end
			return rawGrounded(...)
		end
	end
end
local function getCombatController()
	if combatControllerTable and type(combatControllerTable.onBlockAction) == "function" then
		return combatControllerTable
	end
	if os.clock() - lastCombatControllerScan < 2 then return nil end
	lastCombatControllerScan = os.clock()
	if type(filtergc) == "function" then
		local ok, tables = pcall(function()
			return filtergc("table", { Keys = {"onBlockAction", "onAttackAction"} })
		end)
		if ok and type(tables) == "table" and #tables > 0 then
			combatControllerTable = tables[1]
			hookCombatController(combatControllerTable)
			return combatControllerTable
		end
	end
	return nil
end

local function faceAttacker(eHrp)
	if not eHrp then return end
	local lp = Players.LocalPlayer
	local myChar = lp and lp.Character
	local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myHrp then return end
	local diff = eHrp.Position - myHrp.Position
	local flat = Vector3.new(diff.X, 0, diff.Z)
	if flat.Magnitude > 0.05 then
		myHrp.CFrame = CFrame.lookAt(myHrp.Position, myHrp.Position + flat)
	end
end

local parryInput = {epoch = 0, held = false, releaseAt = 0, pending = nil, nextBegin = 0}
local parryDiagnostic = {attempts = 0, rejected = 0, releases = 0, queued = 0, merged = 0}
local function releaseParryInput()
	if not parryInput.held then return end
	local controller, path, sequence = parryInput.controller, parryInput.path, parryInput.sequence
	parryInput.held, parryInput.controller, parryInput.path, parryInput.sequence = false, nil, nil, nil
	parryDiagnostic.releases += 1
	if path == "controller" then
		if sequence == nil or controller.blockPressSequence == sequence then
			pcall(controller.onBlockAction, nil, Enum.UserInputState.End)
		end
	elseif path == "keyboard" then
		pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game) end)
	end
end

local function resetParryInput()
	parryInput.epoch += 1
	parryInput.pending = nil
	parryInput.manualSequence = nil
	parryInput.nextBegin = 0
	parryInput.lastAttacker, parryInput.lastReportAt, parryInput.lastAction = nil, nil, nil
	releaseParryInput()
	combatControllerTable = nil
	lastCombatControllerScan = -math.huge
	recentParryTokens = {}
end

function parryInput.holdDeadline(char, now)
	local serverNow = workspace:GetServerTimeNow()
	local readyAt = serverNow
	local controller = parryInput.controller
	if controller then readyAt = math.max(readyAt, tonumber(controller.defenseVisualReadyAt) or 0) end
	for _, name in ipairs({"CombatParryStartsAt", "CombatDefensiveParryUnlockAt", "CombatComboDefenseReadyAt", "CombatParryRecoverUntil"}) do
		readyAt = math.max(readyAt, tonumber(char:GetAttribute(name)) or 0)
	end
	local bufferedUntil = readyAt > serverNow and (now + math.clamp(readyAt - serverNow + 0.12, 0, 0.85)) or nil
	return math.max(now + parryHoldMs / 1000, bufferedUntil or 0), bufferedUntil
end

