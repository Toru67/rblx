		pop.TextSize = dmg >= 15 and 24 or (dmg >= 10 and 20 or 17)
		pop.TextColor3 = dmg >= 15 and Color3.fromRGB(255, 50, 70) or (dmg >= 10 and Color3.fromRGB(255, 130, 40) or Color3.fromRGB(255, 220, 70))
