local function hookLocalPlayerCombat(char)
	if not char then return end
	local hum = char:WaitForChild("Humanoid", 2) or char:FindFirstChildOfClass("Humanoid")
	local lastH = hum and hum.Health or 100
	local function checkIncomingAttacker()
		if not appAlive or not targetHudActive then return end
		local lp = Players.LocalPlayer
		local myHrp = char:FindFirstChild("HumanoidRootPart")
		local attacker = nil
		local lastAttackerId = char:GetAttribute("NG_LastAttackerId")
		if typeof(lastAttackerId) == "number" and lastAttackerId > 0 then
			for _, p in ipairs(Players:GetPlayers()) do
				if p.UserId == lastAttackerId and p ~= lp and p.Character then
					local pHrp = p.Character:FindFirstChild("HumanoidRootPart")
					if pHrp and myHrp and (pHrp.Position - myHrp.Position).Magnitude <= 38 then
						attacker = p
						break
					end
				end
			end
		end
		if not attacker and myHrp then
			local bestD = 22
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= lp and p.Character then
					local pHrp = p.Character:FindFirstChild("HumanoidRootPart")
					local pHum = p.Character:FindFirstChildOfClass("Humanoid")
					if pHrp and pHum and pHum.Health > 0 and p.Character:GetAttribute("NG_Dead") ~= true then
						local d = (pHrp.Position - myHrp.Position).Magnitude
						if d < bestD then
							bestD = d
							attacker = p
						end
					end
				end
			end
		end
		if attacker then
			setCombatTarget(attacker, "ATTACKER")
		end
	end
	if hum then
		local hConn = hum.HealthChanged:Connect(function(newH)
			local diff = lastH - newH
			lastH = newH
			if diff > 0.2 then
				lastHitTakenTime = os.clock()
				if hitSpeedActive and hum then
					hum.WalkSpeed = hitSpeedValue
					local cTbl = getCombatTable()
					if cTbl then cTbl.speed = hitSpeedValue end
					char:SetAttribute("CombatGuardSlowUntil", 0)
					char:SetAttribute("CombatMovementLockedUntil", 0)
				end
				checkIncomingAttacker()
			end
		end)
		addConnection(hConn)
	end
	local aConn = char.AttributeChanged:Connect(function(attr)
		if attr == "NG_LastAttackerId" or attr == "CombatLastCleanHitAt" or attr == "CombatStunnedUntil" or attr == "CombatBlockstunUntil" then
			lastHitTakenTime = os.clock()
			if hitSpeedActive and hum then
				hum.WalkSpeed = hitSpeedValue
				local cTbl = getCombatTable()
				if cTbl then cTbl.speed = hitSpeedValue end
				char:SetAttribute("CombatGuardSlowUntil", 0)
				char:SetAttribute("CombatMovementLockedUntil", 0)
			end
			checkIncomingAttacker()
		end
	end)
	addConnection(aConn)
end

