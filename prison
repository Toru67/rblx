	local function validBind(value, mouse, optional)
		if type(value) ~= "string" or #value > 40 then return false end
		if optional and value == "None" then return true end
		if mouse and (value == "MouseButton1" or value == "MouseButton2" or value == "MouseButton3") then return true end
		local ok, key = pcall(function() return Enum.KeyCode[value] end)
		return ok and key ~= nil and key ~= Enum.KeyCode.Unknown and key ~= Enum.KeyCode.Escape and key ~= Enum.KeyCode.Backspace
	end
	local function normalize(data)
		assert(type(data) == "table" and data.schema == "Komorebi" and data.version == 1, "Unsupported config format")
		assert(type(data.settings) == "table" and type(data.binds) == "table", "Missing config sections")
		local values = {}
		for _, entry in ipairs(config.Entries) do
			local value = data.settings[entry.Name]
			if value ~= nil then
				assert(type(value) == entry.Kind, "Invalid setting: " .. entry.Name)
				if entry.Kind == "number" then
					assert(value == value and math.abs(value) < math.huge, "Invalid number: " .. entry.Name)
					value = math.clamp(value, entry.Low, entry.High)
				elseif entry.Choices then
					assert(entry.Choices[value], "Invalid option: " .. entry.Name)
				end
				values[entry.Name] = value
			end
		end
		assert(validBind(data.binds.aim, true, true), "Invalid aim key")
		assert(validBind(data.binds.instantKill, false, true), "Invalid reset key")
		return values
	end
	function config.Save()
		if not appAlive then return end
		if type(writefile) ~= "function" then
			notify("Config", "This executor does not support saving files.")
			return
		end
		local ok = pcall(function()
			local data = {schema = "Komorebi", version = 1, settings = {}, binds = {aim = aimAssistKey, instantKill = instantKillKey}}
			for _, entry in ipairs(config.Entries) do data.settings[entry.Name] = entry.State:get() end
			data.settings = normalize(data)
			writefile(config.Path, HttpService:JSONEncode(data))
		end)
		notify("Config", ok and "Configuration saved. It will load automatically next time." or "Could not save configuration. Check executor file access.")
	end
	function config.Load(automatic)
		if not appAlive then return end
		if type(readfile) ~= "function" then
			notify("Config", "This executor does not support loading saved files.")
			return
		end
		if type(isfile) == "function" then
			local checked, exists = pcall(isfile, config.Path)
			if checked and not exists then
				if not automatic then notify("Config", "No saved configuration yet. Use Save Config first.") end
				return
			end
		end
		local readOK, raw = pcall(readfile, config.Path)
		if not readOK then
			if not automatic then notify("Config", "Could not read configuration. Save one first or check file access.") end
			return
		end
		local valid, data, values = pcall(function()
			assert(type(raw) == "string" and #raw <= 65536, "Invalid config size")
			local decoded = HttpService:JSONDecode(raw)
			return decoded, normalize(decoded)
		end)
		if not valid then
			notify("Config", "Saved configuration is invalid or unsupported. Settings were not changed.")
			return
		end
		capturingAimKey, capturingInstantKillKey = false, false
		aimAssistIsHeld = false
		aimAssistKey, instantKillKey = data.binds.aim, data.binds.instantKill
		local failed = 0
		for _, entry in ipairs(config.Entries) do
			if values[entry.Name] ~= nil then
				local applied = pcall(function() entry.State:set(values[entry.Name], true) end)
				if not applied then failed += 1 end
			end
		end
		if failed > 0 then
			notify("Config", "Configuration loaded, but " .. tostring(failed) .. " setting(s) could not be applied.")
		else
			notify("Config", automatic and "Saved configuration loaded automatically." or "Configuration loaded.")
		end
	end
	config.Load(true)
end

local function matchesBind(input, bKey)
	if not bKey or bKey == "None" or bKey == "" then return false end
	if bKey == "MouseButton1" then return input.UserInputType == Enum.UserInputType.MouseButton1 end
	if bKey == "MouseButton2" then return input.UserInputType == Enum.UserInputType.MouseButton2 end
	if bKey == "MouseButton3" then return input.UserInputType == Enum.UserInputType.MouseButton3 end
	if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
		return input.KeyCode.Name == bKey
	end
	return false
end

local inputConn = UserInputService.InputBegan:Connect(function(input, processed)
	if capturingAimKey then
		local keyName = nil
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
			if input.KeyCode == Enum.KeyCode.Escape then
				capturingAimKey = false
				return
			elseif input.KeyCode == Enum.KeyCode.Backspace then
				keyName = "None"
			else
				keyName = input.KeyCode.Name
			end
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
			keyName = "MouseButton1"
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			keyName = "MouseButton2"
		elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
			keyName = "MouseButton3"
		end
		if keyName then
			aimAssistKey = keyName
			capturingAimKey = false
			notify("Aim Assist", "Keybind set to " .. keyName)
			return
		end
	end

	if capturingInstantKillKey then
		local keyName = nil
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
			if input.KeyCode == Enum.KeyCode.Escape then
				capturingInstantKillKey = false
				return
			elseif input.KeyCode == Enum.KeyCode.Backspace then
				keyName = "None"
			else
				keyName = input.KeyCode.Name
			end
		end
		if keyName then
			instantKillKey = keyName
			capturingInstantKillKey = false
			notify("Instant Kill", "Keybind set to " .. keyName)
			return
		end
	end

	if UserInputService:GetFocusedTextBox() then return end

