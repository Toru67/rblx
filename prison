    box.Position = UDim2.fromOffset(15,82)
    box.BackgroundColor3 = Color3.fromRGB(27,27,33)
    box.BorderSizePixel = 0
    box.ClearTextOnFocus = false
    box.Font = Enum.Font.Gotham
    box.PlaceholderText = "Enter key..."
    box.TextColor3 = Color3.fromRGB(240,240,245)
    box.PlaceholderColor3 = Color3.fromRGB(100,100,110)
    box.TextSize = 14
    box.Parent = frame
    Instance.new("UICorner", box).CornerRadius = UDim.new(0,8)

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1,-30,0,38)
    button.Position = UDim2.fromOffset(15,132)
    button.BackgroundColor3 = Color3.fromRGB(35,35,43)
    button.BorderSizePixel = 0
    button.Font = Enum.Font.GothamBold
    button.Text = "UNLOCK"
    button.TextColor3 = Color3.new(1,1,1)
    button.TextSize = 14
    button.Parent = frame
    Instance.new("UICorner", button).CornerRadius = UDim.new(0,8)

    local discordButton = Instance.new("TextButton")
    discordButton.Size = UDim2.new(1,-30,0,34)
    discordButton.Position = UDim2.fromOffset(15,177)
    discordButton.BackgroundColor3 = Color3.fromRGB(45,45,55)
    discordButton.BorderSizePixel = 0
    discordButton.Font = Enum.Font.GothamBold
    discordButton.Text = "FREE KEY IN DISCORD"
    discordButton.TextColor3 = Color3.new(1,1,1)
    discordButton.TextSize = 13
    discordButton.Parent = frame
    Instance.new("UICorner", discordButton).CornerRadius = UDim.new(0,8)

    local status = Instance.new("TextLabel")
    status.BackgroundTransparency = 1
    status.Size = UDim2.new(1,-30,0,20)
    status.Position = UDim2.fromOffset(15,218)
    status.Font = Enum.Font.Gotham
    status.Text = ""
    status.TextColor3 = Color3.fromRGB(255,90,90)
    status.TextSize = 12
    status.Parent = frame

    discordButton.MouseButton1Click:Connect(function()
        pcall(function()
            if type(setclipboard) == "function" then setclipboard(DISCORD_LINK)
            elseif type(toclipboard) == "function" then toclipboard(DISCORD_LINK) end
        end)
        status.TextColor3 = Color3.fromRGB(170,170,180)
        status.Text = "Discord invite copied!"
    end)

    local dragging, dragStart, startPos = false, nil, nil
    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging, dragStart, startPos = true, input.Position, frame.Position
        end
    end)
    title.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y)
        end
    end)

    local unlocked = false

    -- Remember a successfully entered key for 24 hours.
    -- This uses the executor's file functions when they are available.
    local KEY_CACHE_FILE = "x8_key_cache.txt"
    local KEY_CACHE_DURATION = 24 * 60 * 60

    local function getSavedKeyTime()
        if type(isfile) ~= "function" or type(readfile) ~= "function" then
            return nil
        end

        local ok, value = pcall(function()
            if not isfile(KEY_CACHE_FILE) then
                return nil
            end

            local saved = tonumber(readfile(KEY_CACHE_FILE))
            if not saved then
                return nil
            end

            return saved
        end)

        if ok then
            return value
        end

        return nil
    end

    local function saveKeyTime()
        if type(writefile) ~= "function" then
            return
        end

        pcall(function()
            writefile(KEY_CACHE_FILE, tostring(os.time()))
        end)
    end

    local function hasValidSavedKey()
        local savedTime = getSavedKeyTime()
        if not savedTime then
            return false
        end

        if os.time() - savedTime < KEY_CACHE_DURATION then
            return true
        end

        pcall(function()
            if type(delfile) == "function" and type(isfile) == "function" and isfile(KEY_CACHE_FILE) then
                delfile(KEY_CACHE_FILE)
            end
        end)

        return false
    end

    local function unlockScript()
        if unlocked then return end

        unlocked = true
        status.TextColor3 = Color3.fromRGB(100,255,150)
        status.Text = "Unlocked"
        task.wait(0.15)

        gui:Destroy()
        startX8()
    end

    -- If the key was already entered within the last 24 hours,
    -- skip the key window and load x8 immediately.
    if hasValidSavedKey() then
        gui:Destroy()
        startX8()
        return
    end

    local function tryKey()
        if unlocked then return end

        if box.Text == X8_KEY then
            saveKeyTime()
            unlockScript()
        else
            status.Text = "Invalid key"
            box.Text = ""
            box:CaptureFocus()
        end
    end

    button.MouseButton1Click:Connect(tryKey)
    box.FocusLost:Connect(function(enterPressed) if enterPressed then tryKey() end end)
    box:CaptureFocus()
end

createX8KeySystem()
