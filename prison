		TweenService:Create(slashSparks, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			BackgroundTransparency = 1
		}):Play()
		TweenService:Create(ssGlow, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Transparency = 1
		}):Play()

		task.wait(0.45)

		local fallDur = 1.35
		local fallEase = Enum.EasingStyle.Cubic
		local fallDir = Enum.EasingDirection.In

		local tweenLeft = TweenService:Create(leftHalf, TweenInfo.new(fallDur, fallEase, fallDir), {
			Position = UDim2.new(0, -95, 0, 360),
			Rotation = -28,
			GroupTransparency = 1
		})
		local tweenRight = TweenService:Create(rightHalf, TweenInfo.new(fallDur, fallEase, fallDir), {
			Position = UDim2.new(0.5, 95, 0, 375),
			Rotation = 30,
			GroupTransparency = 1
		})
		local tweenBanner = TweenService:Create(defeatedBanner, TweenInfo.new(fallDur, fallEase, fallDir), {
			Position = UDim2.new(0.5, 0, 0.5, 330),
			Rotation = -7
		})
