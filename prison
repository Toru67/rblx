		local move = tostring(data.Move or "")
		local token = tostring(data.ActionToken or data.ClientActionId or (eChar.Name .. ":" .. move .. ":" .. tostring(data.ExpectedContactAt)))
		local previous = parryInput.latestFeedback[eChar]
		if previous and previous.token == token and previous.epoch == parryInput.epoch and os.clock() - previous.receivedAt < 0.5 then return end
		local feedback = {token = token, epoch = parryInput.epoch, receivedAt = os.clock()}
		parryInput.latestFeedback[eChar] = feedback
		if not isAttackerTargetingMe(eChar) then return end
		local now = workspace:GetServerTimeNow()
		local contactAt = tonumber(data.ExpectedContactAt)
		local waitSeconds = 0
		if contactAt and contactAt > now then
			waitSeconds = math.clamp(contactAt - now - (parryLeadMs / 1000), 0, 0.45)
		end
		if waitSeconds <= 0.02 then
			triggerParry(eChar)
		else
			scheduleParry(waitSeconds, function()
				if autoParryActive and parryInput.latestFeedback[eChar] == feedback and isAttackerTargetingMe(eChar) then
					triggerParry(eChar)
				end
			end)
		end
	end)
