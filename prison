				if type(cTbl.startDash) == "function" then
					pcall(cTbl.startDash)
				end
			end
		end
	end

	if not processed and input.KeyCode == Enum.KeyCode.RightControl then
		windowOpened:set(not windowOpened:get())
	end

	if aimAssistActive and matchesBind(input, aimAssistKey) then
		if aimAssistKeyMode == "Hold" then
			aimAssistIsHeld = true
		elseif aimAssistKeyMode == "Toggle" then
			aimAssistIsHeld = not aimAssistIsHeld
		end
	end
end)
