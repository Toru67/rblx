		if now <= pending.expires and (not pending.action or pending.character:GetAttribute("CombatActionToken") == pending.action) and isAttackerTargetingMe(pending.character) then
			triggerParry(pending.character, true)
		end
	end
	if parryInput.held then
		if legitBlockingAnimActive then
			parryInput.suppressBlockAnim()
		end
		local char = Players.LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 or char:GetAttribute("NG_Knocked") == true or char:GetAttribute("NG_Dead") == true then
			releaseParryInput()
		else
			local _, bufferedUntil = parryInput.holdDeadline(char, now)
			parryInput.releaseAt = math.min(parryInput.hardReleaseAt, math.max(parryInput.releaseAt, bufferedUntil or 0))
			if now >= parryInput.releaseAt then releaseParryInput() end
		end
	end
end))

local function trackEnemyCombat(plr)
	local function onCharacter(char)
		if not char then return end
		local function onActionChanged()
			if not appAlive or not autoParryActive then return end
			local move = tostring(char:GetAttribute("CombatActionMove") or "")
			if move == "" then return end
			if not validAttackMoves[move] and not move:find("M%d") and not move:find("Super") and not move:find("Heavy") and not move:find("Smash") then
				return
			end
			local targeting, dist = isAttackerTargetingMe(char)
			if not targeting then return end
			local token = char.Name .. ":Attr:" .. move .. ":" .. tostring(char:GetAttribute("CombatActionActiveEndsAt") or "pending")
			if recentParryTokens[token] then return end
			recentParryTokens[token] = true
			task.delay(0.5, function() recentParryTokens[token] = nil end)
			local activeEndsValue = char:GetAttribute("CombatActionActiveEndsAt")
			local activeEnds = tonumber(activeEndsValue)
			local function actionStillCurrent()
				return plr.Character == char and char.Parent ~= nil
					and tostring(char:GetAttribute("CombatActionMove") or "") == move
					and char:GetAttribute("CombatActionActiveEndsAt") == activeEndsValue
					and (not activeEnds or activeEnds <= 0 or workspace:GetServerTimeNow() <= activeEnds)
			end
			local nowServer = workspace:GetServerTimeNow()
			local isSuper = (move == "Super") or move:find("Heavy")
			local activeDur = isSuper and 0.18 or 0.24
			if activeEnds and activeEnds > nowServer then
				local contactTime = activeEnds - (activeDur * 0.85)
				local triggerTime = contactTime - (parryLeadMs / 1000)
				local waitSec = math.clamp(triggerTime - nowServer, 0, 0.45)
				if waitSec <= 0.02 then
					triggerParry(char)
				else
					scheduleParry(waitSec, function()
						if autoParryActive and actionStillCurrent() and isAttackerTargetingMe(char) then
							triggerParry(char)
						end
					end)
				end
			else
				local fallbackWait = isSuper and 0.32 or 0.12
				scheduleParry(fallbackWait, function()
					if autoParryActive and actionStillCurrent() and isAttackerTargetingMe(char) then
						triggerParry(char)
					end
				end)
			end
		end
		local queued = false
		local function queueActionChanged()
			if queued or not appAlive or not autoParryActive then return end
			queued = true
			local epoch = parryInput.epoch
			task.defer(function()
				queued = false
				if epoch == parryInput.epoch then onActionChanged() end
			end)
		end
		addConnection(char:GetAttributeChangedSignal("CombatActionMove"):Connect(queueActionChanged))
		addConnection(char:GetAttributeChangedSignal("CombatActionActiveEndsAt"):Connect(queueActionChanged))
	end
	if plr.Character then onCharacter(plr.Character) end
	local cAdded = plr.CharacterAdded:Connect(onCharacter)
	addConnection(cAdded)
end

