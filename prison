local function previewConeAngle()
	local now = os.clock()
	conePreview.startAt = now
	conePreview.expiresAt = now + 3.0
	if not conePreview.folder or not conePreview.folder.Parent then
		conePreview.folder = Instance.new("Folder")
		conePreview.folder.Name = "RereConePreview"
		conePreview.folder.Parent = workspace.CurrentCamera
		conePreview.parts = {}
		for i = 1, 3 + conePreview.arcSegments do
			local p = Instance.new("Part")
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Material = Enum.Material.Neon
			p.Color = Color3.fromRGB(0, 205, 255)
			p.Transparency = 0.25
			p.Parent = conePreview.folder
			table.insert(conePreview.parts, p)
		end
	end
	if not conePreview.conn then
		conePreview.conn = RunService.RenderStepped:Connect(function()
			local curTime = os.clock()
			if curTime >= conePreview.expiresAt then
				cleanupConePreview()
				return
			end
			local lp = Players.LocalPlayer
			local char = lp and lp.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not hrp or not conePreview.folder then
				cleanupConePreview()
				return
			end
			local remaining = conePreview.expiresAt - curTime
			local alpha = 1
			if remaining < 0.4 then
				alpha = remaining / 0.4
			end
			local trans = math.clamp(1 - (1 - 0.25) * alpha, 0.25, 1)
			local centerTrans = math.clamp(1 - (1 - 0.55) * alpha, 0.55, 1)
			local rootCf = hrp.CFrame
			local groundY = hrp.Position.Y - (hrp.Size.Y * 0.5) - 1.95
			local origin = Vector3.new(hrp.Position.X, groundY, hrp.Position.Z)
			local fwd = Vector3.new(rootCf.LookVector.X, 0, rootCf.LookVector.Z).Unit
			local right = Vector3.new(rootCf.RightVector.X, 0, rootCf.RightVector.Z).Unit
			local function getDir(deg)
				local rad = math.rad(deg)
				return (fwd * math.cos(rad) + right * math.sin(rad)).Unit
			end
			local function setLine(part, p1, p2, thickness, tVal)
				local diff = p2 - p1
				local mag = diff.Magnitude
				if mag < 0.001 then
					part.Size = Vector3.zero
					return
				end
				part.Size = Vector3.new(thickness, thickness, mag)
				part.CFrame = CFrame.lookAt((p1 + p2) * 0.5, p2)
				part.Transparency = tVal
			end
			local range = math.clamp(parryRange, 6, 18)
			local leftDir = getDir(-parryAngle)
			local rightDir = getDir(parryAngle)
			setLine(conePreview.parts[1], origin, origin + leftDir * range, 0.12, trans)
			setLine(conePreview.parts[2], origin, origin + rightDir * range, 0.12, trans)
			setLine(conePreview.parts[3], origin, origin + fwd * range, 0.08, centerTrans)
			local prevPt = origin + leftDir * range
			for i = 1, conePreview.arcSegments do
				local frac = i / conePreview.arcSegments
				local deg = -parryAngle + frac * (2 * parryAngle)
				local curPt = origin + getDir(deg) * range
				setLine(conePreview.parts[3 + i], prevPt, curPt, 0.12, trans)
				prevPt = curPt
			end
		end)
	end
end

