			end
			if parryInput.held and (isMine or (parryInput.path == "controller" and parryInput.sequence ~= nil and typeof(data) == "table" and tonumber(data.DefensePressId) == parryInput.sequence)) then
				parryInput.held, parryInput.controller, parryInput.path, parryInput.sequence = false, nil, nil, nil
