local lastHudTick = 0
local function updateStatusHud()
	local now = os.clock()
	if now - lastHudTick < 0.03 then return end
	lastHudTick = now

	local lp = Players.LocalPlayer
	local char = lp and lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")

	if respawnSystem.active then
		respawnSystem.suppress()
		if char and char:GetAttribute("NG_Dead") == true then
			respawnSystem.trigger()
		end
	end

	if visualOverrides.noVignette then
		visualOverrides.suppress(true)
	end

	local isKnocked = isPlayerUnconscious()
	if knockedResetGui and knockedResetGui:FindFirstChild("ResetButton") then
		knockedResetGui.ResetButton.Visible = isKnocked
	end

	if not statusHudActive then
		if statusHudInstance and statusHudInstance.Root then
			statusHudInstance.Root.Visible = false
		end
		return
	end

	if not statusHudInstance or not statusHudInstance.Alive or not statusHudInstance.Gui.Parent then
		statusHudInstance = createStatusHud()
	end
	if not statusHudInstance or not statusHudInstance.Alive then return end

	local health = hum and math.max(0, hum.Health) or 0
	local maxHealth = hum and math.max(1, hum.MaxHealth) or 100
	local healthText = hum and tostring(math.ceil(health)) or "—"
	if isKnocked then
		local downedHp = char and char:GetAttribute("NG_DownedHealth")
		if typeof(downedHp) == "number" then
			healthText = string.format("%d (KO)", math.ceil(downedHp))
		else
			healthText = "KO"
		end
	end
	statusHudInstance.SetValue("Health", health / maxHealth, healthText)

	local stamina = char and (char:GetAttribute("CombatStamina") or char:GetAttribute("Stamina"))
	local maxStamina = char and (char:GetAttribute("CombatStaminaMax") or char:GetAttribute("MaxStamina")) or 100
	maxStamina = math.max(1, maxStamina)

	local staminaRatio = 1
	local staminaText = "100%"
	if infiniteStaminaActive then
		staminaRatio = 1
		staminaText = "100%"
	elseif typeof(stamina) == "number" then
		staminaRatio = math.clamp(stamina / maxStamina, 0, 1)
		staminaText = string.format("%d%%", math.floor((stamina / maxStamina) * 100 + 0.5))
	end
	statusHudInstance.SetValue("Stamina", staminaRatio, staminaText)

	local dodgeRatio = 1
	local dodgeText = "READY"
	if infiniteDashActive then
		dodgeRatio = 1
		dodgeText = "READY"
	elseif char then
		local readyAt = char:GetAttribute("CombatDashReadyAt") or char:GetAttribute("CombatDashCooldownUntil")
		local startedAt = char:GetAttribute("CombatDashStartedAt") or 0
		local serverTime = workspace:GetServerTimeNow()
		if typeof(readyAt) == "number" and readyAt > serverTime then
			local total = math.max(0.1, readyAt - (startedAt > 0 and startedAt or (readyAt - 1.2)))
			local left = readyAt - serverTime
			dodgeRatio = math.clamp(1 - (left / total), 0, 1)
			dodgeText = string.format("%.1f s", left)
		else
			local rem = char:GetAttribute("EvasiveCooldownRemaining")
			if typeof(rem) == "number" and rem > 0 then
				dodgeRatio = math.clamp(1 - rem / 2, 0, 1)
				dodgeText = string.format("%.1f s", rem)
			else
				dodgeRatio = 1
				dodgeText = "READY"
			end
		end
	end
	statusHudInstance.SetValue("Dodge", dodgeRatio, dodgeText)

	local healthIsFull = (not isKnocked) and (health >= maxHealth - 0.5)
	local isMoving = hum and hum.MoveDirection.Magnitude > 0.05
	local isSprinting = isMoving and (char:GetAttribute("CombatSprinting") == true or char:GetAttribute("CombatSprintHeld") == true or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift))
	local staminaIsFull = (not isSprinting) and (typeof(stamina) ~= "number" or stamina >= maxStamina - 0.5)
	if infiniteStaminaActive then
		staminaIsFull = true
	end
	local dodgeIsFull = (dodgeText == "READY")
	if infiniteDashActive then
		dodgeIsFull = true
	end

	local showHealthRow = not statusHudHideWhenFull or statusHudAlwaysHealth or not healthIsFull
	local showStaminaRow = not statusHudHideWhenFull or statusHudAlwaysStamina or not staminaIsFull
	local showDodgeRow = not statusHudHideWhenFull or statusHudAlwaysDodge or not dodgeIsFull

	statusHudInstance.ShowRows({
		Health = showHealthRow,
		Stamina = showStaminaRow,
		Dodge = showDodgeRow
	})
end

