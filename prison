local function updateTargetHud()
	if not appAlive or not targetHudActive then
		if targetHudInstance and targetHudInstance.Gui and targetHudInstance.Gui.Enabled then
			targetHudInstance.Gui.Enabled = false
		end
		return
	end

	if not targetHudInstance or not targetHudInstance.Gui.Parent then
		targetHudInstance = createTargetHud()
	end
	if not targetHudInstance then return end

	local lp = Players.LocalPlayer
	local myChar = lp and lp.Character
	local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myHrp then
		if targetHudInstance.Gui.Enabled then
			targetHudInstance.Gui.Enabled = false
		end
		return
	end

	local targetPlr, targetRole = getCombatTarget()
	local targetChar = targetPlr and targetPlr.Character
	local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
	local targetHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")

	if targetPlr and targetChar and targetHum and targetHrp then
		local curHp = math.max(0, targetHum.Health)
		local maxHp = math.max(1, targetHum.MaxHealth)
		local now = os.clock()

		if targetHudInstance.LastTarget ~= targetPlr then
			targetHudInstance.LastTarget = targetPlr
			targetHudInstance.CurrentHp = curHp
			targetHudInstance.MaxHp = maxHp
			targetHudInstance.Reset()
			targetHudInstance.LastHitTime = now
			targetHudInstance.AvatarImg.Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150", targetPlr.UserId)
			targetHudInstance.NameLabel.Text = string.format("%s (@%s)", targetPlr.DisplayName, targetPlr.Name)
			targetHudInstance.BadgeText.Text = targetRole or "TARGET"
			targetHudInstance.FadeIn()
		end

		local distMeters = math.floor((myHrp.Position - targetHrp.Position).Magnitude * 0.28)
		targetHudInstance.DistText.Text = string.format("Dist: %dm", distMeters)

		if not targetHudInstance.IsDefeated then
			if targetHudInstance.CurrentHp and curHp < targetHudInstance.CurrentHp - 0.5 then
				local dmg = targetHudInstance.CurrentHp - curHp
				targetHudInstance.TriggerShockingHit(dmg)
				lastCombatTargetTime = now
				targetHudInstance.LastHitTime = now
			end

			targetHudInstance.CurrentHp = curHp
			targetHudInstance.MaxHp = maxHp

			local ratio = math.clamp(curHp / maxHp, 0, 1)
			targetHudInstance.HpFill.Size = UDim2.new(ratio, 0, 1, 0)
			targetHudInstance.HpText.Text = string.format("%d / %d HP", math.floor(curHp), math.floor(maxHp))

			if targetHudInstance.GhostRatio ~= ratio then
				targetHudInstance.GhostRatio = ratio
				if targetHudInstance.GhostTween then targetHudInstance.GhostTween:Cancel() end
				targetHudInstance.GhostTween = TweenService:Create(targetHudInstance.DamageGhost, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Size = UDim2.new(ratio, 0, 1, 0)
				})
				targetHudInstance.GhostTween:Play()
			end

			local isDead = (curHp <= 0) or (targetChar:GetAttribute("NG_Dead") == true) or (targetChar:GetAttribute("NG_Knocked") == true)
			if isDead then
				task.spawn(function()
					targetHudInstance.TriggerDefeat()
				end)
			else
				if targetHudInstance.IsFaded then
					targetHudInstance.FadeIn()
				end
			end
		end
	else
		if targetHudInstance.Gui.Enabled and not targetHudInstance.IsDefeated and not targetHudInstance.IsFaded then
			targetHudInstance.FadeOut(function()
				currentCombatTarget = nil
			end)
		end
	end
end

