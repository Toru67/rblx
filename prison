local function getPingSeconds()
	local ping = 0.05
	pcall(function()
		local val = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
		if typeof(val) == "number" and val > 0 then
			ping = val / 1000
		end
	end)
	return math.clamp(ping, 0.01, 0.4)
end

local function getTargetPredictedPosition(targetChar, targetRoot)
	if not aimAssistPrediction or not targetRoot then
		return targetRoot and targetRoot.Position or Vector3.zero
	end
	local ping = getPingSeconds()
	local predictTime = (ping + 0.06) * 1.8 * aimAssistPredScale
	local pos = targetRoot.Position
	local vel = targetRoot.AssemblyLinearVelocity
	local hum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
	local isAirborne = math.abs(vel.Y) > 2
	if hum then
		isAirborne = hum.FloorMaterial == Enum.Material.Air
	end
	if isAirborne then
		return pos + (vel * predictTime) + Vector3.new(0, -workspace.Gravity * 0.5 * (predictTime ^ 2), 0)
	else
		return Vector3.new(pos.X + vel.X * predictTime, pos.Y, pos.Z + vel.Z * predictTime)
	end
end

local function setAimAssist(enabled)
	aimAssistActive = enabled
	if not enabled then
		if aimConn then aimConn:Disconnect(); aimConn = nil end
		aimAssistIsHeld = false
		return
	end
	if aimConn then aimConn:Disconnect(); aimConn = nil end
	aimConn = RunService.RenderStepped:Connect(function()
		if not aimAssistActive then return end
		local shouldTrack = (aimAssistKey == "None") or aimAssistIsHeld
		if not shouldTrack then return end
		local cam = workspace.CurrentCamera
		local lp = Players.LocalPlayer
		local char = lp and lp.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not cam or not hrp then return end
		local inStance = char:GetAttribute("CombatInStance") == true or char:GetAttribute("NG_CombatStanceActive") == true
		if not inStance then return end
		local bestAimPos = nil
		local bestScore = math.huge
		local mousePos = UserInputService:GetMouseLocation()
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= lp and plr.Character then
				local eHrp = plr.Character:FindFirstChild("HumanoidRootPart")
				local eHum = plr.Character:FindFirstChildOfClass("Humanoid")
				if eHrp and eHum and eHum.Health > 0 and plr.Character:GetAttribute("NG_Dead") ~= true and plr.Character:GetAttribute("NG_Knocked") ~= true then
					local screenPt, onScreen = cam:WorldToViewportPoint(eHrp.Position)
					if onScreen then
						local cursorDist = (Vector2.new(screenPt.X, screenPt.Y) - mousePos).Magnitude
						if cursorDist <= aimAssistFov then
							local score = cursorDist
							if aimAssistTargetMode == "Closest to Body" then
								score = (eHrp.Position - hrp.Position).Magnitude
							end
							if score < bestScore then
								bestScore = score
								bestAimPos = getTargetPredictedPosition(plr.Character, eHrp)
							end
						end
					end
				end
			end
		end
		if bestAimPos then
			cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, bestAimPos), aimAssistSmooth)
		end
