		if not row then return end
		if row.Value.Text ~= text then row.Value.Text = text end
		ratio = math.clamp(ratio, 0, 1)
		if row.Ratio == ratio then return end
		row.Ratio = ratio
		if row.FillTween then row.FillTween:Cancel() end
		row.FillTween = TweenService:Create(row.Fill, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.fromScale(ratio, 1)
		})
		row.FillTween:Play()
	end

	local dragged, pointer, origin, marginX, marginY, width, height
	local visibleHeight = 40
	function hud.Layout()
		local viewport = gui.AbsoluteSize
		if viewport.X <= 0 or viewport.Y <= 0 then return end
		local mobile = UserInputService.TouchEnabled
		local factor = 1
		if mobile then
			local portrait = viewport.Y > viewport.X
			local targetWidth = math.min(viewport.X * (portrait and 0.40 or 0.18), math.min(viewport.X, viewport.Y) * 0.45, 195)
			factor = targetWidth / 300
		end
		marginX = mobile and 16 or 48
		marginY = mobile and 16 or 48
		factor = math.min(factor, math.max(0.1, (viewport.X - 2 * marginX) / 300), math.max(0.1, (viewport.Y - 2 * marginY) / 84))
		scale.Scale = factor
		width, height = 300 * factor, visibleHeight * factor
		local baseHeight = 84 * factor
		root.Size = UDim2.fromOffset(width, height)
		content.Size = UDim2.fromOffset(300, visibleHeight)
		local saved = statusHudSavedPos
		local x, y = viewport.X - marginX - width, viewport.Y - marginY - baseHeight
		if type(saved) == "table" and type(saved.X) == "number" and type(saved.Y) == "number" then
			if saved.Layout == 2 then
				x = marginX + saved.X * math.max(0, viewport.X - 2 * marginX - width)
				y = marginY + saved.Y * math.max(0, viewport.Y - 2 * marginY - baseHeight)
			else
				x, y = saved.X * viewport.X, saved.Y * viewport.Y
			end
		end
		if dragged then x, y = root.Position.X.Offset, root.Position.Y.Offset end
		if mobile then
			root.Position = UDim2.fromOffset(x, y)
		else
			root.Position = UDim2.fromOffset(math.clamp(x, marginX, math.max(marginX, viewport.X - marginX - width)), math.clamp(y, marginY, math.max(marginY, viewport.Y - marginY - baseHeight)))
		end
	end

	function hud.ShowRows(flags)
		local count = 0
		for _, key in ipairs({"Health", "Stamina", "Dodge"}) do
			if flags[key] and hud.Rows[key] then count = count + 1 end
		end
		visibleHeight = math.max(40, count * 44 - 4)
		if count > 0 then
			root.Visible = true
		end
		local y = 0
		for _, key in ipairs({"Health", "Stamina", "Dodge"}) do
			local row = hud.Rows[key]
			if row then
				local show = flags[key] == true
				local targetY = show and y or ((row.LastY or y) - 16)
				local stateChanged = (row.Shown ~= show)
				local posChanged = (show and row.TargetY ~= targetY)

				if stateChanged or posChanged then
					row.Token = row.Token + 1
					local token = row.Token
					if row.SlideTween then row.SlideTween:Cancel() end
					local first = (row.Shown == nil)
					row.Shown = show
					row.TargetY = targetY

					if show then
						row.LastY = targetY
						row.Group.Visible = true
						if first then
							row.Group.Position = UDim2.fromOffset(0, targetY - 16)
							row.Group.GroupTransparency = 1
						end
						row.SlideTween = TweenService:Create(row.Group, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
							Position = UDim2.fromOffset(0, targetY),
							Size = UDim2.fromOffset(300, 40),
							GroupTransparency = 0
						})
						row.SlideTween.Completed:Once(function()
							if hud.Alive and row.Token == token then
								row.Group.Visible = true
								row.Group.GroupTransparency = 0
							end
						end)
						row.SlideTween:Play()
					else
						if first then
							row.Group.Visible = false
							row.Group.GroupTransparency = 1
							row.Group.Position = UDim2.fromOffset(0, targetY)
						else
							row.SlideTween = TweenService:Create(row.Group, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
								Position = UDim2.fromOffset(0, targetY),
								Size = UDim2.fromOffset(300, 32),
								GroupTransparency = 1
							})
							row.SlideTween.Completed:Once(function()
								if hud.Alive and row.Token == token then
									row.Group.Visible = false
									local anyVisible = false
									for _, r in pairs(hud.Rows) do
										if r.Shown then anyVisible = true break end
									end
									if not anyVisible then
										root.Visible = false
									end
								end
							end)
							row.SlideTween:Play()
						end
					end
				end

				if show then
					row.LastY = y
					y = y + 44
				end
			end
		end
		hud.Layout()
	end

	local handle = new("TextButton", {
		Name = "DragHandle",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Active = true,
		ZIndex = 30
	}, root)

	local function stopDragging()
		if dragged then
			local viewport = gui.AbsoluteSize
			if UserInputService.TouchEnabled then
				statusHudSavedPos = {
					Layout = 3,
					X = root.Position.X.Offset / math.max(1, viewport.X),
					Y = root.Position.Y.Offset / math.max(1, viewport.Y)
				}
			else
				statusHudSavedPos = {
					Layout = 2,
					X = math.clamp((root.Position.X.Offset - marginX) / math.max(1, viewport.X - 2 * marginX - width), 0, 1),
					Y = math.clamp((root.Position.Y.Offset - marginY) / math.max(1, viewport.Y - 2 * marginY - 84 * scale.Scale), 0, 1)
				}
			end
		end
		dragged, pointer, origin = nil, nil, nil
	end

	connect(handle.InputBegan, function(input)
		if dragged then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			hud.Layout()
			dragged, pointer, origin = input, input.Position, root.Position
		end
	end)

	connect(UserInputService.InputChanged, function(input)
		if not dragged or not pointer then return end
		if (dragged.UserInputType == Enum.UserInputType.Touch and input ~= dragged) or (dragged.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseMovement) then return end
		local viewport, delta = gui.AbsoluteSize, input.Position - pointer
		if not width then return end
		local x, y = origin.X.Offset + delta.X, origin.Y.Offset + delta.Y
		if not UserInputService.TouchEnabled then
			x = math.clamp(x, marginX, math.max(marginX, viewport.X - marginX - width))
			y = math.clamp(y, marginY, math.max(marginY, viewport.Y - marginY - 84 * scale.Scale))
		end
		root.Position = UDim2.fromOffset(x, y)
	end)

	connect(UserInputService.InputEnded, function(input)
		if input == dragged or (dragged and dragged.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1) then
			stopDragging()
		end
	end)

	connect(UserInputService.WindowFocusReleased, stopDragging)

	gui.Destroying:Connect(function()
		hud.Alive = false
		for _, connection in ipairs(hud.Connections) do connection:Disconnect() end
		for _, row in pairs(hud.Rows) do
			if row.FillTween then row.FillTween:Cancel() end
			if row.SlideTween then row.SlideTween:Cancel() end
		end
	end)

	hud.Layout()
	return hud
end

