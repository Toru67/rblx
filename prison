local function isCleanAttackMove(m)
	if not m or m == "" or m == "None" then return false end
	local lower = string.lower(tostring(m))
	if lower:find("walk") or lower:find("idle") or lower:find("stance") or lower:find("block") or lower:find("jump") or lower:find("run") or lower:find("prone") or lower:find("crouch") or lower:find("drag") or lower:find("fall") or lower:find("land") or lower:find("equip") or lower:find("dash") or lower:find("roll") or lower:find("slide") or lower:find("dodge") or lower:find("sprint") or lower:find("step") then
		return false
	end
	return lower:find("^m%d") or lower:find("super") or lower:find("heavy") or lower:find("smash") or lower:find("dropkick") or lower:find("finisher") or lower:find("attack")
end

