local function isAttackerTargetingMe(eChar)
	local lp = Players.LocalPlayer
	local myChar = lp and lp.Character
	local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myHrp or not eChar or eChar == myChar then return false end
	if myChar:GetAttribute("NG_Dead") == true or myChar:GetAttribute("NG_Knocked") == true then return false end
	local eHrp = eChar:FindFirstChild("HumanoidRootPart")
	local eHum = eChar:FindFirstChildOfClass("Humanoid")
	if not eHrp or not eHum or eHum.Health <= 0 then return false end
	if eChar:GetAttribute("NG_Dead") == true or eChar:GetAttribute("NG_Knocked") == true then return false end
	local dir = myHrp.Position - eHrp.Position
	local dist = Vector3.new(dir.X, 0, dir.Z).Magnitude
	if dist > parryRange then return false end
	if dist < 0.05 then return true, dist end
	local flatDir = Vector3.new(dir.X, 0, dir.Z).Unit
	local look = Vector3.new(eHrp.CFrame.LookVector.X, 0, eHrp.CFrame.LookVector.Z).Unit
	local minDot = math.cos(math.rad(parryAngle))
	if look:Dot(flatDir) < minDot then return false end
	return true, dist
end

