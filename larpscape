local config = {dirty = false, due = 0, status = "Auto-save ready"}
function config:decode(data)
    if type(data) ~= "table" then return nil end
    local result = copy(defaults)
    for key, initial in pairs(defaults) do
        local value = data[key]
        if type(initial) == "boolean" and type(value) == "boolean" then result[key] = value
        elseif type(initial) == "number" and finite(value) then
            local range = limits[key]
            result[key] = range and math.clamp(value, range[1], range[2]) or value
        elseif type(initial) == "table" and type(value) == "table" then
            if key == "alternateColor" or key == "skyboxColor" then
                result[key] = {
                    r = finite(value.r) and math.clamp(value.r, 0, 1) or initial.r,
                    g = finite(value.g) and math.clamp(value.g, 0, 1) or initial.g,
                    b = finite(value.b) and math.clamp(value.b, 0, 1) or initial.b,
                }
            end
        end
    end
    if type(data.upgrades) == "table" then
        for name, count in pairs(data.upgrades) do
            if type(name) == "string" and #name <= 100 and finite(count) and count >= 0 then
                result.upgrades[name] = math.floor(math.min(count, 2147483647))
            end
        end
    end
    local ui = data.ui
    if type(ui) == "table" then
        for _, key in ipairs({"x", "y", "width", "height"}) do
            if finite(ui[key]) then result.ui[key] = ui[key] end
        end
        result.ui.width = math.clamp(result.ui.width, 360, 2000)
        result.ui.height = math.clamp(result.ui.height, 260, 1400)
        local camera = workspace.CurrentCamera
        local size = camera and camera.ViewportSize or Vector2.new(1920, 1080)
        result.ui.x = math.clamp(result.ui.x, 0, math.max(0, size.X - 100))
        result.ui.y = math.clamp(result.ui.y, 0, math.max(0, size.Y - 50))
        for _, key in ipairs({"opened", "expanded"}) do
            if type(ui[key]) == "boolean" then result.ui[key] = ui[key] end
        end
        if table.find({"Main", "Classes", "Upgrades", "Ememy", "Config"}, ui.tab) then result.ui.tab = ui.tab end
        if type(ui.sections) == "table" then
            for name, value in pairs(ui.sections) do
                if type(name) == "string" and type(value) == "boolean" then result.ui.sections[name] = value end
            end
        end
    end
    return result
end
function config:load()
    if type(readfile) ~= "function" then return false, "readfile unavailable" end
    local ok, result = pcall(function() return self:decode(HttpService:JSONDecode(readfile(CONFIG_PATH))) end)
    if not ok or not result then return false, "Config missing or invalid" end
    cfg = result
    return true
end
function config:save()
    if type(writefile) ~= "function" then self.status = "Saving unavailable"; return false, self.status end
    local ok, err = pcall(function() writefile(CONFIG_PATH, HttpService:JSONEncode(cfg)) end)
    self.status = ok and "All changes saved" or ("Save failed: " .. tostring(err))
    if ok then self.dirty = false else self.due = os.clock() + 5 end
    return ok, err
end
function config:touch()
    if not app.scope.alive then return end
    if not self.dirty then self.due = os.clock() + 0.5 end
    self.dirty = true
    self.status = "Saving changes..."
end
function config:set(key, value)
    local range = limits[key]
    if range then
        if not finite(value) then return end
        value = math.clamp(value, range[1], range[2])
    end
    cfg[key] = value
    self:touch()
    if app.onSetting then app.onSetting(key) end
end
