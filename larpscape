function enemies:updateSwordMarks()
    local round = ReplicatedStorage:FindFirstChild("InRound")
    if not cfg.voidbreakerSolver or not round or not round.Value then
        if self.swordMarkFolder then self:clearSwordMarks() end
        return
    end
    local folder = workspace:FindFirstChild("Enemies")
    local root = app.character and app.character:FindFirstChild("HumanoidRootPart")
    if not folder or not root then
        if self.swordMarkFolder then self:clearSwordMarks() end
        return
    end
    local seen = {}
    for _, enemy in ipairs(folder:GetChildren()) do
        if enemy.Name == "Voidbreaker" then
            for _, sword in ipairs(enemy:GetChildren()) do
                if sword:IsA("BasePart") and (sword.Name == "Sword" or sword.Name == "SwordFast" or sword.Name == "SwordSlow") then
                    local blade = sword:FindFirstChild("Model2")
                    if blade and blade:IsA("BasePart") and blade.LocalTransparencyModifier < 0.95 then
                        seen[sword] = true
                        local mark = self.swordMarks[sword]
                        if not mark then
                            if not self.swordMarkFolder then
                                self.swordMarkFolder = Instance.new("Folder")
                                self.swordMarkFolder.Name = "LarpscapeVoidbreakerSolver"
                                self.swordMarkFolder.Parent = workspace
                            end
                            mark = Instance.new("Part")
                            mark.Name = "SwordPath"
                            mark.Shape = Enum.PartType.Cylinder
                            mark.Anchored = true
                            mark.CanCollide = false
                            mark.CanTouch = false
                            mark.CanQuery = false
                            mark.Material = Enum.Material.Neon
                            mark.Transparency = 0.55
                            mark.Parent = self.swordMarkFolder
                            self.swordMarks[sword] = mark
                        end
                        -- Voidbreaker's blade points along +UpVector; its spin is around that axis.
                        local direction = blade.CFrame.UpVector
                        local length = blade.Size.Y
                        local markerLength = length * 1.2
                        mark.Size = Vector3.new(markerLength, blade.Size.X * 0.5, blade.Size.X * 0.5)
                        mark.CFrame = CFrame.fromMatrix(blade.Position + direction * (length + markerLength) * 0.5,
                            direction, Vector3.yAxis)
                        local toSword = sword.Position - root.Position
                        local facingSword = toSword.Magnitude < 0.01 or root.CFrame.LookVector:Dot(toSword.Unit) > 0
                        mark.Color = sword.Name == "SwordFast" and not facingSword
                            and Color3.fromRGB(40, 255, 75) or Color3.fromRGB(255, 35, 35)
                    end
                end
            end
        end
    end
    for sword, mark in pairs(self.swordMarks) do
        if not seen[sword] then
            mark:Destroy()
            self.swordMarks[sword] = nil
        end
    end
end
