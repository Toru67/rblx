function enemies:watchSpringer(enemy)
    if self.springerTargets[enemy] then return end
    local scope = Scope.new()
    scope.saved = {}
    self.springerTargets[enemy] = scope

    local function setupKill(kill)
        if not kill or not kill:IsA("BasePart") then return end
        self:applyCrushnt(enemy, kill)
        scope:connect(kill:GetPropertyChangedSignal("CanCollide"), function()
            if cfg.springerCrushnt and kill.CanCollide ~= false then
                kill.CanCollide = false
            end
        end)
        scope:connect(kill:GetPropertyChangedSignal("Size"), function()
            if cfg.springerCrushnt and kill.Size ~= Vector3.new(0.0001, 0.0001, 0.0001) then
                kill.Size = Vector3.new(0.0001, 0.0001, 0.0001)
            end
        end)
    end

    local collision = enemy:FindFirstChild("Collision")
    local kill = collision and collision:FindFirstChild("Kill")
    if kill then setupKill(kill) end

    scope:connect(enemy.DescendantAdded, function(obj)
        if obj.Name == "Kill" and obj:IsA("BasePart") then
            setupKill(obj)
        end
    end)

    local function setupRemote(ce)
        if not ce or not ce:IsA("RemoteEvent") then return end
        scope:connect(ce.OnClientEvent, function(action, data)
            if (action == "Jump" or action == "Drop") and type(data) == "table" and typeof(data.DropPosition) == "Vector3" then
                local duration = enemy:GetAttribute("JumpDuration") or 2.357
                local radius = (enemy:GetAttribute("Big") and 26 or 13) + 2
                self.springerDrops[enemy] = {
                    pos = data.DropPosition,
                    radius = radius,
                    endTime = os.clock() + duration
                }
            end
        end)
    end
    local clientEvent = enemy:FindFirstChild("ClientEvent")
    if clientEvent then setupRemote(clientEvent) end
    scope:connect(enemy.ChildAdded, function(childObj)
        if childObj.Name == "ClientEvent" then setupRemote(childObj) end
    end)

    scope:own(function(restore)
        if restore and enemy.Parent == self.folder then
            for k, state in pairs(scope.saved or {}) do
                if k.Parent then
                    k.Size = state.Size
                    k.CanTouch = state.CanTouch
                    k.CanCollide = state.CanCollide
                    k.CanQuery = state.CanQuery
                end
            end
        end
        table.clear(scope.saved or {})
        self.springerDrops[enemy] = nil
    end)
    scope:connect(enemy.Destroying, function() self:forgetSpringer(enemy, false) end)
end
function enemies:watch(enemy)
    if not cfg.telefraggerAutoBreakAI or enemy.Name ~= "Telefragger" or self.targets[enemy] then return end
    local scope = Scope.new()
    local saved = {}
    self.targets[enemy] = scope
    local function apply(object)
        if saved[object] or not scope.alive then return end
        local property
        if object:IsA("BasePart") then property = "CanTouch"
        elseif object:IsA("BaseScript") and object.Name == "Telefragger_ClientAI" then property = "Enabled" end
        if not property then return end
        saved[object] = {property = property, value = object[property]}
        object[property] = false
    end
    scope:own(function(restore)
        if restore and enemy.Parent == self.folder then
            for object, savedValue in pairs(saved) do
                if object.Parent and object[savedValue.property] == false then object[savedValue.property] = savedValue.value end
            end
        end
        table.clear(saved)
    end)
    scope:connect(enemy.DescendantAdded, apply)
    scope:connect(enemy.DescendantRemoving, function(object) saved[object] = nil end)
    scope:connect(enemy.Destroying, function() self:forget(enemy, false) end)
    apply(enemy)
    for _, object in ipairs(enemy:GetDescendants()) do apply(object) end
    scope.saved = saved
end
function enemies:clear(restore)
    self:clearSwordMarks()
    if self.scope then self.scope:close(false); self.scope = nil end
    for enemy in pairs(self.targets) do self:forget(enemy, restore) end
    for enemy in pairs(self.springerTargets) do self:forgetSpringer(enemy, restore) end
    table.clear(self.springerDrops)
    self:stopSpringerSound()
    if self.warningSound then
        self.warningSound:Destroy()
        self.warningSound = nil
    end
    self.folder = nil
end
function enemies:tick()
    local folder = workspace:FindFirstChild("Enemies")
    if folder ~= self.folder then
        self:clear(false)
        self.folder = folder
        if folder then
            self.scope = Scope.new()
            self.scope:connect(folder.ChildRemoved, function(enemy)
                self:forget(enemy, false)
                self:forgetSpringer(enemy, false)
            end)
        end
    end
    if not folder then return end
    if not cfg.telefraggerAutoBreakAI then
        for enemy in pairs(self.targets) do self:forget(enemy, true) end
    end
    for _, enemy in ipairs(folder:GetChildren()) do
        if enemy.Name == "Kolona" and cfg.kolonaAutoDestroy then enemy:Destroy()
        elseif enemy.Name == "Voidbreaker" and cfg.voidbreakerAutoDestroy then enemy:Destroy()
        elseif enemy.Name == "Telefragger" then self:watch(enemy)
        elseif enemy.Name == "Springer" then self:watchSpringer(enemy) end
    end
    for enemy, scope in pairs(self.targets) do
        if enemy.Parent ~= folder then self:forget(enemy, false)
        else
            for object, saved in pairs(scope.saved) do
                if not object.Parent then scope.saved[object] = nil
                elseif object[saved.property] ~= false then object[saved.property] = false end
            end
        end
    end
    for enemy, scope in pairs(self.springerTargets) do
        if enemy.Parent ~= folder then
            self:forgetSpringer(enemy, false)
        else
            local col = enemy:FindFirstChild("Collision")
            local k = col and col:FindFirstChild("Kill")
            if k then self:applyCrushnt(enemy, k) end
        end
    end
end
function enemies:heartbeat()
    local sound = self:initSound()
    local inSpot = false
    if cfg.springerWarningSound and self.folder then
        local char = plr.Character
        local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Hitbox"))
        local pPos = root and root.Position
        local now = os.clock()
        for enemy, scope in pairs(self.springerTargets) do
            if enemy.Parent == self.folder then
                local mark = enemy:FindFirstChild("SpringerMark")
                if mark and mark:IsA("BasePart") and mark.Size.X > 1 then
                    local r = (enemy:GetAttribute("Big") and 26 or 13) + 2
                    if not self.springerDrops[enemy] or self.springerDrops[enemy].endTime < now + 0.1 then
                        self.springerDrops[enemy] = {
                            pos = mark.Position,
                            radius = r,
                            endTime = now + 0.25
                        }
                    end
                end
            end
        end
        if pPos then
            for enemy, drop in pairs(self.springerDrops) do
                if now >= drop.endTime or not enemy.Parent or enemy.Parent ~= self.folder then
                    self.springerDrops[enemy] = nil
                else
                    local x = pPos.X - drop.pos.X
                    local z = pPos.Z - drop.pos.Z
                    local horiz = math.sqrt(x * x + z * z)
                    local vert = math.abs(pPos.Y - drop.pos.Y)
                    if horiz <= drop.radius and vert <= 30 then
                        inSpot = true
                        break
                    end
                end
            end
        end
    else
        table.clear(self.springerDrops)
    end
    if inSpot then
        if sound and not sound.IsPlaying then sound:Play() end
    else
        if sound and sound.IsPlaying then sound:Stop() end
    end
end
