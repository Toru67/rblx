    top.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = root.Position
        end
    end)
    app.scope:connect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            local x = startPos.X.Offset + delta.X
            local y = startPos.Y.Offset + delta.Y
            root.Position = UDim2.fromOffset(x, y)
            window.position:set(Vector2.new(x, y))
        end
    end)
    app.scope:connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                local pos = root.AbsolutePosition
                cfg.ui.x, cfg.ui.y = pos.X, pos.Y
                config:touch()
            end
            dragging = false
        end
    end)

    app.scope:connect(UserInputService.InputBegan, function(input, processed)
        if UserInputService:GetFocusedTextBox() then return end
        if input.KeyCode == Enum.KeyCode.K then
            if not processed then
