function trajectory:style(part, visible, size, cframe, color, alpha)
    part.Transparency = visible and (alpha or 0.15) or 1
    if visible then part.Size, part.CFrame, part.Color = size, cframe, color end
    local overlay = part.TrajectoryOverlay
    overlay.Size, overlay.Color3, overlay.Visible = part.Size, part.Color, visible
    overlay.Transparency = math.min(part.Transparency + 0.08, 1)
end
function trajectory:line(part, first, last, width, color, alpha)
    local length = (last - first).Magnitude
    self:style(part, length > 0.001, Vector3.new(width, width, math.max(length, 0.01)),
        length > 0.001 and CFrame.lookAt((first + last) / 2, last) or CFrame.new(first), color, alpha)
end
function trajectory:ensure()
    if self.scope then return end
    self.scope = Scope.new()
    local folder = Instance.new("Folder")
    folder.Name = "LarpscapeSpiritTrajectory"
    self.scope:own(function() folder:Destroy() end)
    self.folder = folder
    folder.Parent = workspace
    self.landing = self:marker("SpiritLandingCenter", Enum.PartType.Ball)
    self.beacon = self:marker("SpiritLandingBeacon", Enum.PartType.Ball)
    for i = 1, 16 do self.ring[i] = self:marker("SpiritLandingRing") end
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "SpiritLandingLabel"
    billboard.Adornee = self.landing
    billboard.AlwaysOnTop, billboard.LightInfluence = true, 0
    billboard.MaxDistance = 10000
    billboard.Size = UDim2.fromOffset(192, 50)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
    billboard.Parent = self.landing
    local text = Instance.new("TextLabel")
    text.Name = "Summary"
    text.Size = UDim2.fromScale(1, 1)
    text.BackgroundColor3 = Color3.fromRGB(12, 16, 27)
    text.BackgroundTransparency = 0.2
    text.BorderSizePixel = 0
    text.Font = Enum.Font.GothamBold
    text.TextSize = 14
    text.TextStrokeTransparency = 0.7
    text.TextWrapped = true
    text.Parent = billboard
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 9)
    corner.Parent = text
    self.label = text
end
function trajectory:predict(controller, origin, delta, fastPreview)
    local movement, root = controller.Movement, controller.Movement.RootPart
    local multiplier = movementFeatures:spiritMultiplier(delta.Magnitude)
    local velocity = Vector3.new(delta.X * 2.5 * multiplier,
        math.max(delta.Y, 0) ^ 0.85 * 2.5 + 25, delta.Z * 2.5 * multiplier)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {movement.Character, controller.activeStatue, self.folder}
    params.RespectCanCollide, params.CollisionGroup = true, root.CollisionGroup
    local humanoid = movement.Humanoid
    local footOffset = humanoid.HipHeight + root.Size.Y / 2
    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        local leg = movement.Character:FindFirstChild("Left Leg")
        footOffset += leg and leg.Size.Y or 2
    end
    local position, points = origin, {origin}
    local hitPosition, hitNormal, flightTime = nil, nil, 0
    -- Aiming uses a coarse six-second preview; launch prediction keeps the
    -- original 0.04s/150-step precision. Both paths remain collision-aware.
    local dt, gravity = fastPreview and 0.1 or 0.04, workspace.Gravity
    local maxSteps = fastPreview and 60 or 150
    for stepIndex = 1, maxSteps do
        local nextPosition = position + velocity * dt + Vector3.new(0, -0.5 * gravity * dt * dt, 0)
        local step = nextPosition - position
        -- Preview collision checks are sampled every third integration step;
        -- the points still integrate every step, so the visual path stays smooth
        -- while raycast work is reduced to roughly 20 checks per refresh.
        local sampleCollision = not fastPreview or stepIndex % 3 == 1
        local hit = sampleCollision and workspace:Raycast(position, step, params)
        -- The precise launch path performs the foot-offset ground ray. Preview
        -- intentionally skips it to keep aiming responsive.
        local floorHit = (not fastPreview and velocity.Y <= 0)
            and workspace:Raycast(position - Vector3.new(0, footOffset, 0), step, params)
        if floorHit and floorHit.Normal.Y > 0.5 and (not hit or floorHit.Distance < hit.Distance) then
            hitPosition, hitNormal = floorHit.Position, floorHit.Normal
            table.insert(points, hitPosition + Vector3.new(0, footOffset, 0))
            flightTime += dt * math.clamp(floorHit.Distance / math.max(step.Magnitude, 0.001), 0, 1)
            break
        elseif hit then
            hitPosition, hitNormal = hit.Position, hit.Normal
            table.insert(points, hitPosition)
            flightTime += dt * math.clamp(hit.Distance / math.max(step.Magnitude, 0.001), 0, 1)
            break
        end
        table.insert(points, nextPosition)
        position = nextPosition
        velocity += Vector3.new(0, -gravity * dt, 0)
        flightTime += dt
    end
    local kind = not hitPosition and "unknown" or (hitNormal.Y > 0.5 and "landing" or "wall")
    return {points = points, target = hitPosition or position, normal = hitNormal or Vector3.yAxis,
        kind = kind, duration = flightTime, distance = ((hitPosition or position) - origin).Magnitude}
end
function trajectory:draw(prediction, showPath)
    self.prediction = prediction
    local points = prediction.points
    -- Preserve the shortened 75% path with at most 28 pooled dashes.
    local endIndex = math.max(1, math.floor((#points - 1) * 0.75))
    local count = showPath and math.min(22, endIndex) or 0
    self.segmentCount = count
    for i = 1, count do
        local first = points[1 + math.floor((i - 1) * endIndex / count)]
        local last = points[1 + math.floor(i * endIndex / count)]
        local segment = self.segments[i]
        if not segment then segment = self:marker(); self.segments[i] = segment end
        local t = (i - 1) / math.max(count - 1, 1)
        self:line(segment, first:Lerp(last, 0.08), first:Lerp(last, 0.92), 0.14,
            Color3.fromRGB(65 + 130 * t, 225 - 100 * t, 255), 0.25)
    end
    for i = count + 1, #self.segments do self:style(self.segments[i], false) end
    local normal, target = prediction.normal, prediction.target
    local reference = math.abs(normal.Y) > 0.95 and Vector3.xAxis or Vector3.yAxis
    local tangent = normal:Cross(reference).Unit
    local bitangent = normal:Cross(tangent).Unit
    local center = target + normal * 0.12
    local color = prediction.kind == "landing" and Color3.fromRGB(95, 255, 170)
        or (prediction.kind == "wall" and Color3.fromRGB(255, 105, 135) or Color3.fromRGB(255, 195, 80))
    prediction.color, prediction.center = color, center
    -- An unknown endpoint gets an amber beacon, never a false landing ring.
    for i, part in ipairs(self.ring) do
        if prediction.kind == "unknown" then self:style(part, false)
        else
            local a, b = (i - 1) * math.pi * 2 / 16, i * math.pi * 2 / 16
            local first = center + (tangent * math.cos(a) + bitangent * math.sin(a)) * 2.2
            local last = center + (tangent * math.cos(b) + bitangent * math.sin(b)) * 2.2
            self:line(part, first, last, 0.13, color, 0.15)
        end
    end
    self:style(self.landing, true, Vector3.new(0.45, 0.45, 0.45), CFrame.new(center), color, 0.12)
    self:style(self.beacon, true, Vector3.new(0.32, 0.32, 0.32), CFrame.new(center + normal * 1.3), color, 0.1)
    self.label.TextColor3 = color
    self:updateLabel(os.clock())
end
function trajectory:updateLabel(now)
    local prediction = self.prediction
    if not prediction or not self.label then return end
    if prediction.kind == "unknown" then
        self.label.Text = "NO LANDING FOUND\nWithin 6 seconds of flight"
        return
    end
    local seconds = self.flightEnds and math.max(0, self.flightEnds - now) or prediction.duration
    local name = prediction.kind == "landing" and "LANDING (EST.)" or "WALL HIT (EST.)"
    self.label.Text = string.format("%s\n%.0f studs  |  ~%.1fs", name, prediction.distance, seconds)
end
function trajectory:preview(dt)
    local controller, movement = app.special, app.movement
    if not cfg.spiritTrajectory or not app:valid(movement) or app.specialID ~= "Spirit" or not controller then
        self:clear(); return
    end
    if self.flightEnds then return end -- launch prediction is retained until landing
    if not movement.spirit or not controller.slingshot then self:clear(); return end
    local root, statue = movement.RootPart, controller.statueRoot
    if not statue or not statue.Parent or not controller.activeStatue then self:clear(); return end
    self:ensure()
    local origin, delta = statue.Position, statue.Position - root.Position
    self.previewElapsed += math.max(0, dt or 0)
    local moved = self.previewController ~= controller
        or not self.previewOrigin or (origin - self.previewOrigin).Magnitude >= TRAJECTORY_PREVIEW_MOVE
        or not self.previewDelta or (delta - self.previewDelta).Magnitude >= TRAJECTORY_PREVIEW_MOVE
    if moved or self.previewElapsed >= TRAJECTORY_PREVIEW_FRAME then
        self.previewElapsed = 0
        self.previewController, self.previewOrigin, self.previewDelta = controller, origin, delta
        self:draw(self:predict(controller, origin, delta, true), true)
    end
end
function trajectory:animate(dt)
    if not self.scope then return end
    if not cfg.spiritTrajectory or not app:valid(app.movement) or self.previewController ~= app.special then
        self:clear(); return
    end
    local now = os.clock()
    if self.flightEnds and now >= self.flightEnds + 0.65 then self:clear(); return end
    self.animationElapsed += math.max(0, dt or 0)
    if self.animationElapsed < TRAJECTORY_FRAME then return end
    -- RenderStep normally arrives at 60 Hz. Keep a remainder so a slow frame
    -- does not permanently shift the animation clock.
    self.animationElapsed -= TRAJECTORY_FRAME
    local prediction = self.prediction
    if not prediction then return end
    -- Animate existing parts only: no tweens, extra connections, or raycasts.
    local phase = (now * 0.7) % 1
    for i = 1, self.segmentCount do
        local segment = self.segments[i]
        local t = (i - 1) / math.max(self.segmentCount - 1, 1)
        local distance = math.abs(t - phase)
        local glow = math.max(0, 1 - math.min(distance, 1 - distance) / 0.18)
        local width = 0.13 + 0.08 * glow
        local color = Color3.fromRGB(65 + 130 * t + 45 * glow, 225 - 100 * t + 25 * glow, 255)
        self:style(segment, true, Vector3.new(width, width, segment.Size.Z), segment.CFrame, color, 0.35 - 0.3 * glow)
    end
    local pulse = (math.sin(now * 3) + 1) / 2
    for _, part in ipairs(self.ring) do
        if prediction.kind ~= "unknown" then
            self:style(part, true, part.Size, part.CFrame, prediction.color, 0.1 + 0.15 * pulse)
        end
    end
    self:style(self.beacon, true, Vector3.new(0.32, 0.32, 0.32),
        CFrame.new(prediction.center + prediction.normal * (1.2 + 0.25 * pulse)), prediction.color, 0.1)
    self:updateLabel(now)
end
function trajectory:tick()
    local controller, movement = app.special, app.movement
    if not cfg.spiritTrajectory or not app:valid(movement) or app.specialID ~= "Spirit" or not controller then
        self:clear(); return
    end
    if self.flightEnds then
        if os.clock() >= self.flightEnds + 0.65 then self:clear()
        elseif not movement.spirit then return end
    end
    if not movement.spirit or not controller.slingshot then self:clear(); return end
    local root, statue = movement.RootPart, controller.statueRoot
    if not statue or not statue.Parent or not controller.activeStatue then self:clear(); return end
    self:ensure()
    self.flightEnds, self.previewController = nil, controller
    self:draw(self:predict(controller, statue.Position, statue.Position - root.Position), true)
end
app.onSpiritLaunch = function(controller, origin, delta)
    if not cfg.spiritTrajectory or not origin or not delta or not app:valid(controller.Movement) then return end
    trajectory:ensure()
    trajectory.previewController = controller
    local prediction = trajectory:predict(controller, origin, delta)
    trajectory.flightEnds = os.clock() + prediction.duration
    trajectory:draw(prediction, false)
end

local function isAlternateColor(c)
    if typeof(c) ~= "Color3" then return false end
    local r, g, b = c.R, c.G, c.B
    if math.abs(r - 0.258824) < 0.03 and math.abs(g - 1) < 0.03 and math.abs(b - 0.878431) < 0.03 then return true end
    if math.abs(r - 74/255) < 0.03 and math.abs(g - 1) < 0.03 and math.abs(b - 195/255) < 0.03 then return true end
    if math.abs(r - 98/255) < 0.03 and math.abs(g - 203/255) < 0.03 and math.abs(b - 1) < 0.03 then return true end
    if math.abs(r - 53/255) < 0.03 and math.abs(g - 1) < 0.03 and math.abs(b - 205/255) < 0.03 then return true end
    if math.abs(r - 53/255) < 0.03 and math.abs(g - 225/255) < 0.03 and math.abs(b - 1) < 0.03 then return true end
    if math.abs(r - 151/255) < 0.03 and math.abs(g - 253/255) < 0.03 and math.abs(b - 1) < 0.03 then return true end
    if math.abs(r - 0) < 0.03 and math.abs(g - 190/255) < 0.03 and math.abs(b - 1) < 0.03 then return true end
    if math.abs(r - 76/255) < 0.04 and math.abs(g - 190/255) < 0.04 and math.abs(b - 1) < 0.04 then return true end
    if g > 0.65 and b > 0.65 and r < 0.5 then return true end
    return false
end

local function randomBrightColor()
    return Color3.fromHSV(math.random(), 0.55 + math.random() * 0.45, 0.65 + math.random() * 0.35)
end

local visuals = {
    hooked = false,
    oldNewIndex = nil,
    currentAltColor = Color3.new(0.706, 0.196, 1),
    currentAltBeamColor = Color3.new(0.8, 0.3, 1),
    currentAltUiColor = Color3.new(0.85, 0.5, 1),
    currentAltSeq = ColorSequence.new(Color3.new(0.706, 0.196, 1)),
    currentSkyColor = Color3.new(0.47, 0.16, 0.86),
    originalSkyColors = {},
    atmo = nil,
}

function visuals:syncColorsFromConfig()
    local c = cfg.alternateColor
    self.currentAltColor = Color3.new(c.r, c.g, c.b)
    local h, s, v = self.currentAltColor:ToHSV()
    self.currentAltBeamColor = Color3.fromHSV(h, math.max(0.15, s - 0.2), math.min(1, v + 0.1))
    self.currentAltUiColor = Color3.fromHSV(h, math.max(0.2, s - 0.15), math.min(1, v + 0.15))
    self.currentAltSeq = ColorSequence.new(self.currentAltColor)
    local sc = cfg.skyboxColor
    self.currentSkyColor = Color3.new(sc.r, sc.g, sc.b)
end

function visuals:transformSequence(seq)
    local kps = seq.Keypoints
    local changed = false
    local newKps = {}
    for _, kp in ipairs(kps) do
        if isAlternateColor(kp.Value) then
            changed = true
            table.insert(newKps, ColorSequenceKeypoint.new(kp.Time, self.currentAltColor))
        else
            table.insert(newKps, kp)
        end
    end
    return changed and ColorSequence.new(newKps) or seq
end

function visuals:patchBullet()
    local projFolder = ReplicatedFirst:FindFirstChild("ClientModules")
    local pc = projFolder and projFolder:FindFirstChild("ProjectileClient")
    local pch = pc and pc:FindFirstChild("ProjectileClientHandler")
    local projs = pch and pch:FindFirstChild("Projectiles")
    local bcScript = projs and projs:FindFirstChild("BulletClient")
    local bc = bcScript and bcScript:FindFirstChild("BulletColorblind")
    if bc then
        bc.Color = self.currentAltColor
        for _, desc in ipairs(bc:GetDescendants()) do
            if desc:IsA("ParticleEmitter") or desc:IsA("Beam") then
                desc.Color = self.currentAltSeq
            elseif desc:IsA("Highlight") then
                desc.OutlineColor = self.currentAltColor
                desc.FillColor = self.currentAltColor
            end
        end
    end
end

function visuals:patchUI()
    local pgui = plr:FindFirstChild("PlayerGui")
    local gui = pgui and pgui:FindFirstChild("GUI")
    if gui then
        local gold = child(gui, "Main", "Misc", "Container", "Gold")
        if gold and gold:IsA("ImageLabel") then gold.ImageColor3 = self.currentAltUiColor end
        local gifts = gui:FindFirstChild("Gifts")
        if gifts and gifts:IsA("TextLabel") then gifts.TextColor3 = self.currentAltUiColor end
    end
end

function visuals:patchPools()
    local pools = workspace:FindFirstChild("Item_Pools")
    if not pools then return end
    for _, name in ipairs({"SigilPartsGroup", "SigilBeamGroup", "SigilBlastGroup"}) do
        local group = pools:FindFirstChild(name)
        if group then
            for _, item in ipairs(group:GetChildren()) do
                if item:IsA("BasePart") then
                    item.Color = self.currentAltColor
                end
            end
        end
    end
end

function visuals:ensureColorblindSetting()
    local mod = child(ReplicatedFirst, "ClientModules", "Core", "PlayerData", "SettingsHandler")
    local handler = import(mod)
    if handler and type(handler.Get) == "function" and type(handler.Set) == "function" then
        if not handler.Get({"Graphics", "Colorblind"}) then
            handler.Set({"Graphics", "Colorblind"}, true)
        end
    end
end

function visuals:applyAlternateColor()
    if not cfg.alternateColorEnabled then return end
    self:syncColorsFromConfig()
    self:ensureColorblindSetting()
    self:patchBullet()
    self:patchUI()
    self:patchPools()
end

function visuals:applySkyboxColor()
    if not cfg.skyboxColorEnabled then
        self:restoreSkybox()
        return
    end
    self:syncColorsFromConfig()
    local color = self.currentSkyColor
    local skyMod = workspace:FindFirstChild("SkyboxModule")
    if skyMod then
        for _, desc in ipairs(skyMod:GetDescendants()) do
            if desc:IsA("BasePart") then
                if self.originalSkyColors[desc] == nil then
                    self.originalSkyColors[desc] = desc.Color
                end
                desc.Color = color
            end
        end
    end
    local skyPart = workspace:FindFirstChild("SkyboxPart")
    if skyPart and skyPart:IsA("BasePart") then
        if self.originalSkyColors[skyPart] == nil then
            self.originalSkyColors[skyPart] = skyPart.Color
        end
        skyPart.Color = color
    end
    local atmo = Lighting:FindFirstChild("LarpscapeAtmosphere")
    if not atmo then
        atmo = Instance.new("Atmosphere")
        atmo.Name = "LarpscapeAtmosphere"
        atmo.Density = 0.3
        atmo.Haze = 2
        atmo.Parent = Lighting
    end
    atmo.Color = color
    self.atmo = atmo
end

function visuals:restoreSkybox()
    for part, original in pairs(self.originalSkyColors) do
        if part and part.Parent and typeof(original) == "Color3" then
            pcall(function() part.Color = original end)
        end
    end
    table.clear(self.originalSkyColors)
    local atmo = Lighting:FindFirstChild("LarpscapeAtmosphere")
    if atmo then
        pcall(function() atmo:Destroy() end)
    end
    self.atmo = nil
end

function visuals:rollColor(target)
    local col = randomBrightColor()
    if target == "alternate" or target == "both" then
        cfg.alternateColor = {r = col.R, g = col.G, b = col.B}
        self:applyAlternateColor()
    end
    if target == "skybox" or target == "both" then
        local skyCol = (target == "both") and randomBrightColor() or col
        cfg.skyboxColor = {r = skyCol.R, g = skyCol.G, b = skyCol.B}
        self:applySkyboxColor()
    end
    if app.syncUI then app.syncUI() end
    config:touch()
end

function visuals:onRoundStart()
    if cfg.alternateRandomRound then
        self:rollColor("alternate")
    else
        self:applyAlternateColor()
    end
    if cfg.skyboxRandomRound then
        self:rollColor("skybox")
    else
        self:applySkyboxColor()
    end
end

function visuals:restore()
    if self.hooked and self.oldNewIndex then
        hookmetamethod(game, "__newindex", self.oldNewIndex)
        self.hooked = false
        self.oldNewIndex = nil
    end
    self:restoreSkybox()
end

function visuals:init()
    if self.hooked then return end
    self:syncColorsFromConfig()
    self.oldNewIndex = hookmetamethod(game, "__newindex", function(selfObj, key, val)
        if cfg.alternateColorEnabled then
            if key == "Color" or key == "OutlineColor" or key == "FillColor" then
                if typeof(val) == "Color3" and isAlternateColor(val) then
                    val = visuals.currentAltColor
                elseif typeof(val) == "ColorSequence" then
                    val = visuals:transformSequence(val)
                end
            elseif key == "ImageColor3" or key == "TextColor3" then
                if typeof(val) == "Color3" and isAlternateColor(val) then
                    val = visuals.currentAltUiColor
                end
            end
        end
        return visuals.oldNewIndex(selfObj, key, val)
    end)
    self.hooked = true
    app.scope:own(function()
        visuals:restore()
    end)
    app.scope:connect(workspace.DescendantAdded, function(desc)
        if cfg.skyboxColorEnabled and desc:IsA("BasePart") then
            if desc.Name == "SkyboxPart" or (desc.Parent and desc.Parent.Name == "Skyspheres") then
                task.defer(function()
                    if cfg.skyboxColorEnabled and desc.Parent then
                        if visuals.originalSkyColors[desc] == nil then
                            visuals.originalSkyColors[desc] = desc.Color
                        end
                        desc.Color = visuals.currentSkyColor
                    end
                end)
            end
        end
    end)
    self:applyAlternateColor()
    self:applySkyboxColor()
end


local discovery = {mobile = nil, retired = setmetatable({}, {__mode = "k"})}
function app:detachSpecial(restore)
    local controller, scope = self.special, self.specialScope
    self.special, self.specialID, self.specialScope = nil, nil, nil
    if controller then discovery.retired[controller] = true end
    if scope then scope:close(restore) end
    trajectory:clear()
    glider:clear()
end
function app:detachMovement(restore)
    local movement, scope = self.movement, self.movementScope
    self.movement, self.movementScope = nil, nil
    self.epoch += 1
    if movement then discovery.retired[movement] = true end
    self:detachSpecial(restore)
    if scope then scope:close(restore) end
    table.clear(upgrades.baselines)
    table.clear(upgrades.applied)
    magnet.applied = false
    self.status = "Waiting for movement controller..."
end
function app:detachCharacter(character)
    if character ~= self.character then return end
    local scope = self.characterScope
    self.removed[character] = true
    self.character, self.characterScope = nil, nil
    self:detachMovement(false)
    if scope then scope:close(false) end
    self.status = "Waiting for character..."
end
function app:bindCharacter(character)
    if character == self.character or self.removed[character] or not self.scope.alive then return end
    if self.character then self:detachCharacter(self.character) end
    self.epoch += 1
    self.character = character
    local scope = Scope.new()
    self.characterScope = scope
    scope:connect(character.Destroying, function() self:detachCharacter(character) end)
    scope:connect(character.AncestryChanged, function(_, parent)
        if not parent then self:detachCharacter(character) end
    end)
    bell:bind(scope)
    self.status = "Waiting for movement controller..."
end
function app:bindMovement(movement)
    if movement == self.movement or discovery.retired[movement] or not self:valid(movement) then return end
    if self.movement then self:detachMovement(false) end
    self.movement = movement
    local scope = Scope.new()
    self.movementScope = scope
    movementFeatures:bind(movement, scope)
    self:queue("upgrades/spawn", function() upgrades:sync(true) end, 0.5, true)
end
function app:bindSpecial(controller, id)
    if controller == self.special then return end
    self:detachSpecial(false)
    if type(controller) ~= "table" or discovery.retired[controller] or not self:valid(controller.Movement) then return end
    self.special, self.specialID = controller, id
    local scope = Scope.new()
    self.specialScope = scope
    movementFeatures:bindSpecial(controller, id, scope)
    self.status = tostring(id or "Movement") .. " ready"
end
function discovery:tick()
    if plr.Character ~= app.character then
        if app.character then app:detachCharacter(app.character) end
        if plr.Character then app:bindCharacter(plr.Character) end
    end
    if not app.character or app.removed[app.character] then return end
    if not self.mobile then self.mobile = import(child(ReplicatedStorage, "Mobile", "MobileHandler")) end
    local callback = self.mobile and self.mobile.Buttons and self.mobile.Buttons.Special
    callback = callback and callback.Function
    if type(callback) ~= "function" or type(debug.getupvalues) ~= "function" then
        app.status = "Movement binding unavailable"
        return
    end
    local current
    for _, value in pairs(debug.getupvalues(callback)) do
        if type(value) == "table" and value.Character == app.character
            and value.Initialised == true and not self.retired[value] and app:valid(value) then current = value; break end
    end
    if current ~= app.movement then
        if app.movement then app:detachMovement(false) end
        if current then app:bindMovement(current) end
    end
    if current then app:bindSpecial(current.ActiveSpecial, current.SpecialID) end
end
function app:stop()
    if not self.scope.alive or self.stopping then return end
    self.stopping = true
    if config.dirty then self:run("config/stop", function() config:save() end) end
    self:run("visuals/restore", function() visuals:restore() end)
    self:run("upgrades/restore", function() upgrades:restore() end)
    self:run("magnet/restore", function() magnet:restore() end)
    self.epoch += 1
    table.clear(self.jobs)
    self.scope:close(true)
    if self.character then self:detachCharacter(self.character) else self:detachMovement(false) end
    enemies:cleanupSpawnedVoidbreaker()
    enemies:clear(true)
    self.notify, self.syncUI, self.onSetting, self.onSpiritLaunch = nil, nil, nil, nil
    discovery.mobile = nil
    upgrades.handler, upgrades.source = nil, nil
end
function app:start()
    self:run("visuals/init", function() visuals:init() end)
    self.scope:connect(plr.CharacterAdded, function(character)
        self:bindCharacter(character)
        self:queue("visuals/spawn", function() visuals:onRoundStart() end, 0.3, true)
    end)
    self.scope:connect(plr.CharacterRemoving, function(character) self:detachCharacter(character) end)
    if plr.Character then self:bindCharacter(plr.Character) end
    local levelObj = ReplicatedStorage:FindFirstChild("Level")
    if levelObj then
        self.scope:connect(levelObj.Changed, function()
            self:queue("visuals/level", function() visuals:onRoundStart() end, 0.5, true)
            self:queue("enemies/level", function() enemies:onRoundStart() end, 0.6, true)
        end)
    end
    local elapsed, roundValue, roundState = {discover = 0, upgrades = 0}, nil, nil
    local busy = false
    local animationName = "LarpscapeTrajectoryAnimation"
    RunService:BindToRenderStep(animationName, Enum.RenderPriority.Last.Value + 3, function(dt)
        if self.scope.alive and not self.stopping then
            self:run("trajectory/preview", function() trajectory:preview(dt) end)
            self:run("trajectory/animation", function() trajectory:animate(dt) end)
            self:run("enemies/voidbreakerSolver", function() enemies:updateSwordMarks() end)
        end
    end)
    self.scope:own(function() RunService:UnbindFromRenderStep(animationName) end)
    self.scope:connect(RunService.Heartbeat, function(dt)
        if busy or self.stopping then return end
        busy = true
        local ok, err = pcall(function()
            self:drainJobs()
            if not self.scope.alive then return end
            self:run("glider", function() glider:tick() end)
            self:run("enemies/springer", function() enemies:heartbeat() end)
            elapsed.discover += dt
            elapsed.upgrades += dt
            if elapsed.discover >= 0.5 then
                elapsed.discover = 0
                self:run("discovery", function() discovery:tick() end)
                local value = ReplicatedStorage:FindFirstChild("InRound")
                local active = value and value.Value == true
                if value ~= roundValue or active ~= roundState then
                    roundValue, roundState = value, active
                    table.clear(upgrades.baselines)
                    table.clear(upgrades.applied)
                    magnet:resetState()
                    if active then
                        self:queue("upgrades/round", function() upgrades:sync(true) end, 0.5, true)
                        self:queue("visuals/round", function() visuals:onRoundStart() end, 0.2, true)
                        self:queue("enemies/voidbreaker", function() enemies:onRoundStart() end, 0.3, true)
                    else
                        enemies:onRoundEnd()
                    end
                end
                self:run("enemies", function() enemies:tick() end)
                self:run("magnet", function() magnet:tick() end)
            end
            if elapsed.upgrades >= 1 then
                elapsed.upgrades = 0
                if cfg.autoRefreshUpgrades then self:run("upgrades", function() upgrades:sync(false) end) end
            end
            if config.dirty and os.clock() >= config.due then config:save() end
        end)
        busy = false
        if not ok then self:report("scheduler", err) end
    end)
end


