-- Boioing renders Nausea at Last+1 using a non-orthonormal matrix (shear/scale).
-- CFrame:Lerp interpolates rotations and cannot safely blend this distortion.
-- Each Nausea matrix component is linear in effect strength, so interpolate
-- components directly. B * (I + amount * (D - I)) = B + amount * (B*D - B).
local bell = {}
function bell:reduce(before, after, amount)
    if amount <= 0 then return before end
    if amount >= 1 then return after end
    local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = before:GetComponents()
    local ax, ay, az, a00, a01, a02, a10, a11, a12, a20, a21, a22 = after:GetComponents()
    return CFrame.new(
        x + (ax - x) * amount, y + (ay - y) * amount, z + (az - z) * amount,
        r00 + (a00 - r00) * amount, r01 + (a01 - r01) * amount, r02 + (a02 - r02) * amount,
        r10 + (a10 - r10) * amount, r11 + (a11 - r11) * amount, r12 + (a12 - r12) * amount,
        r20 + (a20 - r20) * amount, r21 + (a21 - r21) * amount, r22 + (a22 - r22) * amount)
end
function bell:bind(scope)
    local before, camera
    local preName, postName = "LarpscapeBellBefore", "LarpscapeBellAfter"
    RunService:BindToRenderStep(preName, Enum.RenderPriority.Last.Value, function()
        before, camera = nil, nil
        if not scope.alive or not app:valid(app.movement) then return end
        if not cfg.bellBreakDistortion and cfg.bellDistortionReduction <= 0 then return end
        if not app.character:FindFirstChild("Boioing") then return end
        camera = workspace.CurrentCamera
        before = camera and camera.CFrame
    end)
    RunService:BindToRenderStep(postName, Enum.RenderPriority.Last.Value + 2, function()
        if scope.alive and before and camera == workspace.CurrentCamera and app:valid(app.movement) then
            local remaining = cfg.bellBreakDistortion and 0 or 1 - cfg.bellDistortionReduction / 100
            camera.CFrame = bell:reduce(before, camera.CFrame, remaining)
        end
        before, camera = nil, nil
    end)
    scope:own(function()
        RunService:UnbindFromRenderStep(preName)
        RunService:UnbindFromRenderStep(postName)
        before, camera = nil, nil
    end)
end


local trajectory = {
