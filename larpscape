function trajectory:marker(name, shape)
    local part = Instance.new("Part")
    part.Name = name or "SpiritTrajectoryMarker"
    part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery = true, false, false, false
    part.Material = Enum.Material.Neon
    part.CastShadow = false
    part.Shape = shape or Enum.PartType.Block
    part.Transparency = 1
    local overlay = Instance.new("BoxHandleAdornment")
    overlay.Name = "TrajectoryOverlay"
    overlay.Adornee, overlay.AlwaysOnTop, overlay.ZIndex = part, true, 1
