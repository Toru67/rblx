local Scope = {}
Scope.__index = Scope
function Scope.new()
    return setmetatable({alive = true, cleanups = {}}, Scope)
end
function Scope:own(cleanup)
    if self.alive then table.insert(self.cleanups, cleanup) else pcall(cleanup, false) end
    return cleanup
end
function Scope:connect(signal, callback)
    local connection = signal:Connect(function(...)
        if self.alive then callback(...) end
    end)
    self:own(function() connection:Disconnect() end)
    return connection
end
function Scope:patch(object, key, build)
    local raw = rawget(object, key)
    local original = object[key]
    if type(original) ~= "function" then return false end
    local replacement = build(original)
    object[key] = replacement
    self:own(function()
        if object[key] == replacement then object[key] = raw end
    end)
    return true
end
function Scope:close(restore)
    if not self.alive then return end
    self.alive = false -- Invalidate first, before callbacks or game destructors run.
    for i = #self.cleanups, 1, -1 do
        local ok, err = xpcall(self.cleanups[i], debug.traceback, restore == true)
        if not ok then warn("Larpscape cleanup: " .. tostring(err)) end
    end
    table.clear(self.cleanups)
end

local app = {
    scope = Scope.new(), character = nil, characterScope = nil, movement = nil,
    movementScope = nil, special = nil, specialID = nil, specialScope = nil, epoch = 0,
    removed = setmetatable({}, {__mode = "k"}), jobs = {}, errors = {},
    notify = nil, syncUI = nil, onSetting = nil, onSpiritLaunch = nil, status = "Starting...",
}
function app:report(key, err)
    local now = os.clock()
    if now - (self.errors[key] or -100) < 10 then return end
    self.errors[key] = now
    warn("Larpscape " .. key .. ": " .. tostring(err))
end
function app:run(key, callback, ...)
    if not self.scope.alive then return end
    local ok, result = pcall(callback, ...)
    if not ok then self:report(key, result) end
    return ok, result
end
function app:queue(key, callback, delay, characterBound)
    if not self.scope.alive then return end
    self.jobs[key] = {callback = callback, due = os.clock() + (delay or 0),
        epoch = characterBound and self.epoch or nil}
end
function app:drainJobs()
    local now = os.clock()
    local batch = self.jobs
    self.jobs = {}
    for key, item in pairs(batch) do
        if self.scope.alive and (item.epoch == nil or item.epoch == self.epoch) then
            if item.due <= now then self:run(key, item.callback)
            elseif not self.jobs[key] then self.jobs[key] = item end
        end
    end
end
function app:valid(movement)
    if not self.scope.alive or not self.characterScope or not self.characterScope.alive then return false end
    if not self.character or self.removed[self.character] or plr.Character ~= self.character
        or not self.character.Parent then return false end
    if not movement or movement.Character ~= self.character then return false end
    local root, humanoid = movement.RootPart, movement.Humanoid
    return root ~= nil and root:IsDescendantOf(self.character)
        and humanoid ~= nil and humanoid.Parent == self.character and humanoid.Health > 0
end
function app:inRound()
    local value = ReplicatedStorage:FindFirstChild("InRound")
    return value ~= nil and value.Value == true and self:valid(self.movement)
end
local function child(parent, ...)
    for _, name in ipairs({...}) do
        parent = parent and parent:FindFirstChild(name)
    end
    return parent
end
local function import(source)
    if not source or not source:IsA("ModuleScript") then return nil end
    local ok, result = pcall(require, source)
    if ok then return result end
    app:report(source.Name, result)
    return nil
end
local function finite(value)
    return type(value) == "number" and value == value and math.abs(value) < math.huge
end
local function copy(value)
    if type(value) ~= "table" then return value end
    local result = {}
    for key, item in pairs(value) do result[key] = copy(item) end
    return result
end


