}
local TRAJECTORY_FRAME = 1 / 60
-- Keep visual animation at 60 FPS, but use a shorter coarse simulation for aiming.
-- This avoids hundreds of raycasts on every render frame while staying responsive.
local TRAJECTORY_PREVIEW_FRAME = 1 / 60
local TRAJECTORY_PREVIEW_MOVE = 0.012
function trajectory:clear()
