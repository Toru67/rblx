local movementFeatures = {}
function movementFeatures:spiritMultiplier(distance)
    return 1 + (cfg.spiritFlingStrength - 1) * (1 - math.clamp(distance / cfg.spiritFlingDistance, 0, 1))
end
function movementFeatures:shark(controller, alternate)
    local movement = controller.Movement
    if not app:valid(movement) then return end
    local root = controller.RootPart or movement.RootPart
    local value = alternate and cfg.sharkTailAltAbilityStrength or cfg.sharkTailAbilityStrength
    local velocity = root.AssemblyLinearVelocity
    root.AssemblyLinearVelocity = Vector3.new(velocity.X, velocity.Y * value, velocity.Z)
end
function movementFeatures:clearBonk(movement, velocity, hit)
    if not app:valid(movement) then return end
    movement.diveBonked, movement.bonkedOffPlayer = false, false
    if movement.Animator then movement.Animator:StopAnimation("DiveBonk") end
    movement.Humanoid:SetAttribute("UsingAbility", false)
    movement:AdjustHitbox(3, 0.5)
    local root = movement.RootPart
    local normal = hit and hit.Normal
    if typeof(normal) == "Vector3" then
        local inward = velocity:Dot(normal)
        if inward < 0 then velocity -= normal * inward end
        root.CFrame += normal * 0.35
    end
    root.AssemblyLinearVelocity = velocity
end
function movementFeatures:bind(movement, scope)
    scope:patch(movement, "DiveBonk", function(original)
        return function(self, hit, ...)
            if not scope.alive or not app:valid(self) or (not cfg.softAntiBonk and not cfg.hardAntiBonk) then
                return original(self, hit, ...)
            end
            local velocity = self.RootPart.AssemblyLinearVelocity
            if cfg.hardAntiBonk then
                movementFeatures:clearBonk(self, velocity, hit)
                return false
            end
            local results = table.pack(original(self, hit, ...))
            app:queue("softBonk", function()
                if scope.alive then movementFeatures:clearBonk(self, velocity, hit) end
            end, 0, true)
            return table.unpack(results, 1, results.n)
        end
    end)
    scope:patch(movement, "Unload", function(original)
        return function(self, ...)
            -- Unload runs before/independently of CharacterRemoving in MovementLoader.
            if app.movement == self then app:detachMovement(false) end
            return original(self, ...)
        end
    end)
end
function movementFeatures:bindSpecial(controller, id, scope)
    local function valid()
        return scope.alive and app.special == controller and app:valid(controller.Movement)
    end
    scope:patch(controller, "Reset", function(original)
        return function(self, ...)
            if app.special == self then app:detachSpecial(false) end
            return original(self, ...)
        end
    end)
    if id == "Glider" then
        -- Glider stores charge in Time/TimeClamp. Step also updates steering,
        -- collisions and animation, so always pass the real frame delta through.
        local function refill(self)
            if valid() and cfg.gliderInfiniteStamina and finite(self.TimeClamp) and self.TimeClamp > 0 then
                self.Time = self.TimeClamp
            end
        end
        for _, method in ipairs({"SpecialAction", "Start"}) do
            scope:patch(controller, method, function(original)
                return function(self, ...)
                    refill(self)
                    return original(self, ...)
                end
            end)
        end
        scope:patch(controller, "Step", function(original)
            return function(self, dt, ...)
                if not valid() then return original(self, dt, ...) end
                refill(self)
                local capacity = self.TimeClamp
                local before = finite(self.Time) and finite(capacity) and capacity > 0
                    and math.clamp(self.Time, 0, capacity)
                local results = table.pack(original(self, dt, ...))
                if not valid() then return table.unpack(results, 1, results.n) end
                if cfg.gliderInfiniteStamina then
                    refill(self)
                elseif before and self.TimeClamp == capacity and finite(self.Time) then
                    -- Original Step checks exhaustion before subtracting charge;
                    -- correct the raw delta before the next exhaustion check.
                    local spent = before - self.Time
                    if spent > 0 and cfg.gliderStaminaExtension > 1 then
                        self.Time = math.max(0, before - spent / cfg.gliderStaminaExtension)
                    end
                end
                if finite(self.Time) and finite(capacity) and capacity > 0 then
                    local bar = child(self.UI, "Frame", "Bar")
                    if bar then
                        local size = bar.Size
                        bar.Size = UDim2.new(math.clamp(self.Time / capacity, 0, 1), 0,
                            size.Y.Scale, size.Y.Offset)
                    end
                end
                -- Original Step assigns a fresh glide velocity every frame.
                -- Scale that output once, only while gliding; preserve bonk/End.
                if cfg.gliderSpeedEnabled and self.Movement.gliding and not self.Movement.RootPart.Anchored then
                    local root = self.Movement.RootPart
                    root.AssemblyLinearVelocity *= cfg.gliderSpeed
                end
                return table.unpack(results, 1, results.n)
            end
        end)
    elseif id == "Spirit" then
        scope:patch(controller, "Step", function(original)
            return function(self, dt, ...)
                if valid() and cfg.spiritInfiniteStamina then self.stamina = 1; dt = 0 end
                return original(self, dt, ...)
            end
        end)
        scope:patch(controller, "SpecialAction", function(original)
            return function(self, input, ...)
                if not valid() then return original(self, input, ...) end
                local movement, root, statue = self.Movement, self.Movement.RootPart, self.statueRoot
                local origin = statue and statue.Position
                local delta = origin and origin - root.Position
                local sling = self.slingshot and movement.spirit
                local oldSpeed = movement.spiritSlingshotSpeed or 0
                local multiplier = delta and movementFeatures:spiritMultiplier(delta.Magnitude) or 1
                -- Bypass only the launch input gate, after a slingshot statue exists.
                -- Keeping this out of Step preserves mode toggles and prevents an
                -- always-cleared cooldown from allowing repeated statue creation.
                local savedCooldown = self.cooldown
                local bypass = cfg.spiritNoLaunchCooldown and input == Enum.UserInputState.Begin
                    and sling and statue and statue.Parent and self.activeStatue and self.activeStatue.Parent
                    and not self.antiFlyTech and savedCooldown == true
                if bypass then self.cooldown = false end
                local results = table.pack(pcall(original, self, input, ...))
                if bypass and valid() and movement.spirit then self.cooldown = savedCooldown end
                if not results[1] then error(results[2], 0) end
                if valid() and input == Enum.UserInputState.Begin and sling and delta
                    and not movement.spirit and not self.slingshot then
                    if multiplier > 1 then
                        local velocity = root.AssemblyLinearVelocity
                        root.AssemblyLinearVelocity = Vector3.new(delta.X * 2.5 * multiplier, velocity.Y, delta.Z * 2.5 * multiplier)
                        local horizontal = Vector3.new(delta.X, 0, delta.Z)
                        if horizontal.Magnitude > 0.001 then movement:SetMoveDirection(horizontal.Unit) end
                        movement.spiritSlingshotSpeed = oldSpeed + horizontal.Magnitude / 1.5 * multiplier
                    end
                    if app.onSpiritLaunch then app:run("trajectory/launch", app.onSpiritLaunch, self, origin, delta) end
                end
                return table.unpack(results, 2, results.n)
            end
        end)
    elseif id == "Dive" then
        scope:patch(controller, "Start", function(original)
            return function(self, powered, ...)
                local results = table.pack(original(self, powered, ...))
                if valid() then
                    local root = self.RootPart or self.Movement.RootPart
                    local mult = powered and cfg.diverAltMultiplier or cfg.diverMainMultiplier
                    local bodyVelocity = root:FindFirstChild("DiveVelocity")
                    if bodyVelocity and bodyVelocity:IsA("BodyVelocity") then
                        local v = bodyVelocity.Velocity
                        bodyVelocity.Velocity = Vector3.new(v.X * mult, v.Y, v.Z * mult)
                        local force = bodyVelocity.MaxForce
                        local forceScale = math.max(mult, 1) * 2
                        bodyVelocity.MaxForce = Vector3.new(force.X * forceScale, force.Y, force.Z * forceScale)
                    end
                    local v = root.AssemblyLinearVelocity
                    root.AssemblyLinearVelocity = Vector3.new(v.X * mult,
                        v.Y * (cfg.diverCollectionMode and cfg.diverCollectionVerticalMultiplier or 1), v.Z * mult)
                end
                return table.unpack(results, 1, results.n)
            end
        end)
    elseif id == "Grapple" then
        scope:patch(controller, "Cast", function(original)
            return function(self, memoryCast, ...)
                if not valid() or not cfg.grapplerRangeEnabled then return original(self, memoryCast, ...) end
                self.grappleParams.FilterDescendantsInstances = self.Movement.moveCastParams.FilterDescendantsInstances
                local root, range = self.RootPart, cfg.grapplerRange
                local target
                if tick() - self.memoryUpdate <= 0.25 and not memoryCast then
                    target = self.memoryPosition
                elseif UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
                    or self.Movement.preferredInput ~= Enum.PreferredInput.KeyboardAndMouse then
                    local camera = workspace.CurrentCamera
                    if not camera then return nil end
                    local origin = (camera.CFrame * self.cameraOffset).Position + camera.CFrame.LookVector
                        * (camera.CFrame.Position - (root.Position + self.Humanoid.CameraOffset)).Magnitude
                    local result = workspace:Raycast(origin, camera.CFrame.LookVector * range, self.grappleParams)
                    target = result and result.Position
                else
                    local ray = plr:GetMouse().UnitRay
                    local result = workspace:Raycast(ray.Origin, ray.Direction * 2048, self.grappleParams)
                    if not result then return nil, ray.Direction end
                    target = result.Position
                end
                if not target or (target - root.Position).Magnitude < 0.001 then return nil end
                return workspace:Raycast(root.Position, (target - root.Position).Unit * range, self.grappleParams)
            end
        end)
        scope:patch(controller, "Step", function(original)
            return function(self, dt, ...)
                local results = table.pack(original(self, dt, ...))
                if valid() and self.Movement.grappling then
                    local movement = self.Movement
                    local wings = movement:HasUpgrade("GraceWings") and 1.5 or 1
                    self.RootPart.AssemblyLinearVelocity += movement.PlayerMoveDirection
                        * (cfg.grapplerStrength - 12) * wings * dt * movement.movementSpeedMulti
                end
                return table.unpack(results, 1, results.n)
            end
        end)
    elseif id == "Charger" then
        scope:patch(controller, "End", function(original)
            return function(self, ...)
                if not valid() or not cfg.chargerNoCooldown then return original(self, ...) end
                local rawTween = rawget(self, "BarTween")
                local noop = function() end
                self.BarTween = noop
                local results = table.pack(pcall(original, self, ...))
                if self.BarTween == noop then self.BarTween = rawTween end
                if not results[1] then error(results[2], 0) end
                if valid() then
                    self.debounceIDX = (self.debounceIDX or 0) + 1
                    self.debounce, self.lastDebounceWasTripmine = false, false
                    if self.activeBarTween then self.activeBarTween:Cancel(); self.activeBarTween = nil end
                    local frame = child(self.UI, "Frame")
                    if frame then frame.Visible = false end
                end
                return table.unpack(results, 2, results.n)
            end
        end)
        scope:patch(controller, "Step", function(original)
            return function(self, dt, ...)
                local results = table.pack(original(self, dt, ...))
                if valid() and self.Movement.charging then
                    local movement = self.Movement
                    if cfg.chargerSpeedEnabled then
                        movement.classSpeedMulti = math.clamp((movement.classSpeedMulti or 0) * cfg.chargerSpeed, 0, 2 * cfg.chargerSpeed)
                    end
                    if cfg.chargerTurnSpeedEnabled then
                        local wanted = movement.WantDirection
                        if typeof(wanted) ~= "Vector3" or wanted.Magnitude < 0.001 then wanted = movement.PlayerMoveDirection end
                        local current = movement.TrueMoveUnit
                        if typeof(wanted) == "Vector3" and typeof(current) == "Vector3" then
                            wanted *= Vector3.new(1, 0, 1)
                            current *= Vector3.new(1, 0, 1)
                            if wanted.Magnitude > 0.001 then
                                if current.Magnitude < 0.001 then current = wanted end
                                local alpha = 1 - math.exp(-math.max(0, cfg.chargerTurnSpeed - 1) * 8 * dt)
                                local direction = current.Unit:Lerp(wanted.Unit, alpha)
                                if direction.Magnitude > 0.001 then movement:SetMoveDirection(direction.Unit) end
                            end
                        end
                    end
                end
                return table.unpack(results, 1, results.n)
            end
        end)
    end
    if id == "Dive" or id == "Grapple" or id == "Charger" then
        local alternate
        for _, key in ipairs({"SpecialAction", "AltSpecialAction"}) do
            scope:patch(controller, key, function(original)
                return function(self, ...)
                    if not valid() then return original(self, ...) end
                    local previous = alternate
                    if alternate == nil then alternate = key == "AltSpecialAction" end
                    local results = table.pack(pcall(original, self, ...))
                    alternate = previous
                    if not results[1] then error(results[2], 0) end
                    return table.unpack(results, 2, results.n)
                end
            end)
        end
        scope:patch(controller, id == "Dive" and "TryDive" or "SharkTail", function(original)
            return function(self, ...)
                local before = valid() and self.Movement.diving
                if valid() and id == "Dive" and cfg.diverRepeatedAirDives then self.Movement.slideJumped = false end
                local results = table.pack(original(self, ...))
                if valid() and (id ~= "Dive" or (before and not self.Movement.diving and self.Movement.diveSharkTech)) then
                    movementFeatures:shark(self, alternate)
                end
                return table.unpack(results, 1, results.n)
            end
        end)
    end
end


-- Low-frequency adapters; no replay of foreign event connections and no native hooks.
local upgrades = {handler = nil, source = nil, baselines = {}, applied = {}, nextRefresh = 0}
function upgrades:resolve()
    local source = child(ReplicatedFirst, "ClientModules", "UpgradeHandler")
    if self.source ~= source or not self.handler then self.handler = import(source); self.source = source end
    return self.handler
end
function upgrades:setCount(name, count)
    if not app:inRound() then return false end
    local epoch, movement = app.epoch, app.movement
    local handler = self:resolve()
    if not handler or type(handler.GetUpgradeStack) ~= "function" then return false end
    if type(getsenv) ~= "function" then app:report("Upgrades", "getsenv unavailable"); return false end
    local ok, environment = pcall(getsenv, self.source)
    local apply = ok and environment and environment.OnUpgradesChanged
    if type(apply) ~= "function" then app:report("Upgrades", "UpgradeHandler not ready"); return false end
    if self.baselines[name] == nil then self.baselines[name] = handler.GetUpgradeStack(name) end
    local succeeded, err = pcall(apply, {[name] = count})
    if not succeeded then app:report("Upgrades", err); return false end
    if epoch ~= app.epoch or not app:valid(movement) then return false end
    local folder = child(ReplicatedStorage, "UpgradeFolder", "Upgrades")
    if folder then
        local value = folder:FindFirstChild(name)
        if not value then value = Instance.new("IntValue"); value.Name = name; value.Parent = folder end
        if value:IsA("IntValue") then value.Value = count end
    end
    self.applied[name] = count
    return true
end
function upgrades:sync(force)
    if not app:inRound() then return end
    local handler = self:resolve()
    if not handler then return end
    for name, count in pairs(cfg.upgrades) do
        if not app:inRound() then break end
        if count > 0 and (force or cfg.autoRefreshUpgrades) then
            local value = child(ReplicatedStorage, "UpgradeFolder", "Upgrades", name)
            if handler.GetUpgradeStack(name) ~= count or not value or value.Value ~= count
                or (force and self.applied[name] ~= count) then self:setCount(name, count) end
        end
    end
end
function upgrades:restore()
    if not app:inRound() then return end
    local handler = self:resolve()
    for name, initial in pairs(self.baselines) do
        if handler and handler.GetUpgradeStack(name) == self.applied[name] then self:setCount(name, initial) end
    end
    table.clear(self.baselines)
    table.clear(self.applied)
end
function upgrades:change(name, delta)
    local count = math.max(0, math.min(2147483647, (cfg.upgrades[name] or 0) + delta))
    cfg.upgrades[name] = count
    config:touch()
    app:queue("upgrade/" .. name, function() self:setCount(name, count) end, 0, true)
end
function upgrades:reconcile()
    for name, applied in pairs(self.applied) do
        if not cfg.upgrades[name] or cfg.upgrades[name] <= 0 then
            local handler = self:resolve()
            if handler and handler.GetUpgradeStack(name) == applied then self:setCount(name, self.baselines[name] or 0) end
            self.applied[name], self.baselines[name] = nil, nil
        end
    end
    self:sync(true)
end

local magnet = {applied = false, appliedRange = nil, appliedMode = nil}

function magnet:resetState()
    self.applied = false
    self.appliedRange = nil
    self.appliedMode = nil
end

function magnet:tick()
    if not app:inRound() then return end

    local event = child(ReplicatedStorage, "Events", "MovementGiftMagnet")
    if not event then return end

    local evil = cfg.evilGiftMagnet == true
    local range = evil and 300 or math.clamp(tonumber(cfg.magnetRange) or 1, 1, 30)

    -- MovementGiftMagnet uses an Add/Reset style API. The old implementation
    -- sent Add every 0.5 seconds, which could repeatedly stack the value and
    -- put unnecessary load on the game's input/movement handler. Only apply
    -- the value when the requested mode/range actually changes.
    if range <= 1 then
        if self.applied then
            event:Fire({Reset = math.huge})
            self:resetState()
        end
        return
    end

    if self.applied and self.appliedRange == range and self.appliedMode == evil then
        return
    end

    if self.applied then
        event:Fire({Reset = math.huge})
    end

    event:Fire({Add = range})
    self.applied = true
    self.appliedRange = range
    self.appliedMode = evil
end

function magnet:restore()
    if self.applied and app:inRound() then
        local event = child(ReplicatedStorage, "Events", "MovementGiftMagnet")
        if event then event:Fire({Reset = math.huge}) end
    end
    self:resetState()
end

local glider = {scope = nil, force = nil, root = nil, sample = Vector3.zero}
function glider:clear()
    if self.scope then self.scope:close(false) end
    self.scope, self.force, self.root = nil, nil, nil
    self.sample = Vector3.zero
end
function glider:tick()
    local movement = app.movement
    if not cfg.eBoostEnabled or cfg.gliderSpeedEnabled or not app:valid(movement)
        or movement.SpecialID ~= "Glider" then self:clear(); return end
    local root = movement.RootPart
    if self.root ~= root then self:clear(); self.root = root; self.sample = root.AssemblyLinearVelocity end
    if not UserInputService:IsKeyDown(Enum.KeyCode.E) then
        if self.force then self.force.Enabled = false end
        self.sample = root.AssemblyLinearVelocity
        return
    end
    if not self.force then
        local scope = Scope.new()
        self.scope = scope
        local attachment = root:FindFirstChild("RootAttachment")
        if not attachment then
            attachment = Instance.new("Attachment")
            attachment.Name = "LarpscapeEBoostAttachment"
            attachment.Parent = root
            scope:own(function() attachment:Destroy() end)
        end
        local force = Instance.new("LinearVelocity")
        force.Name = "LarpscapeEBoost"
        force.Attachment0 = attachment
        force.RelativeTo = Enum.ActuatorRelativeTo.World
        force.MaxForce = math.huge
        force.Parent = root
        self.force = force
        scope:own(function() force:Destroy() end)
    end
    self.sample = self.sample:Lerp(root.AssemblyLinearVelocity / cfg.eBoostMult, 0.15)
    self.force.VectorVelocity = self.force.VectorVelocity:Lerp(self.sample * cfg.eBoostMult, 0.18)
    self.force.Enabled = true
end

