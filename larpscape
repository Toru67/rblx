        dot.BackgroundColor3 = Color3.new(1, 1, 1)
        dot.BorderSizePixel = 0
        dot.Parent = bar
        rounded(dot, 8)

        local range = limits[key]
        local minValue, maxValue = range[1], range[2]
        local control = {kind = "slider", key = key, step = step or 1, last = cfg[key], enabled = true, normalValueLabel = nil}
        local function roundStep(v)
            local q = math.floor(((v - minValue) / control.step) + 0.5)
            return math.clamp(minValue + q * control.step, minValue, maxValue)
        end
        function control:set(value)
            local v = tonumber(value) or minValue
            v = roundStep(v)
            self.last = v
            local alpha = (v - minValue) / (maxValue - minValue)
            fill.Size = UDim2.new(alpha, 0, 1, 0)
            dot.Position = UDim2.new(alpha, 0, 0.5, 0)
            local precision = self.step < 0.1 and 2 or (self.step < 1 and 1 or 0)
            valueLabel.Text = string.format("%." .. precision .. "f", v)
            if self.enabled then
                valueLabel.TextColor3 = C.accent
                label.TextColor3 = C.text
                fill.BackgroundColor3 = C.accent
                dot.BackgroundColor3 = Color3.new(1, 1, 1)
            end
        end
        function control:setEnabled(enabled, displayText)
            self.enabled = enabled ~= false
            hit.Active = self.enabled
            hit.Selectable = self.enabled
            label.TextColor3 = self.enabled and C.text or C.muted
            valueLabel.TextColor3 = self.enabled and C.accent or C.muted
            fill.BackgroundColor3 = self.enabled and C.accent or C.panel2
            dot.BackgroundColor3 = self.enabled and Color3.new(1, 1, 1) or C.muted
            bar.BackgroundColor3 = self.enabled and C.panel3 or C.panel2
            if displayText ~= nil then
                valueLabel.Text = tostring(displayText)
            elseif self.enabled then
                local precision = self.step < 0.1 and 2 or (self.step < 1 and 1 or 0)
                valueLabel.Text = string.format("%." .. precision .. "f", self.last)
            end
        end
        control:set(cfg[key])
        controls[key] = control

        local dragging = false
        local function setFromX(x)
            if not control.enabled then return end
            local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            local v = minValue + (maxValue - minValue) * a
            v = roundStep(v)
            config:set(key, v)
            control:set(v)
        end
        hit.InputBegan:Connect(function(input)
            if not control.enabled then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                setFromX(input.Position.X)
            end
        end)
        app.scope:connect(UserInputService.InputChanged, function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                setFromX(input.Position.X)
            end
        end)
        app.scope:connect(UserInputService.InputEnded, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        return control
    end

    local function addColor(body, labelText, key)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 42)
        row.BackgroundTransparency = 1
        row.Parent = body
        local text = Instance.new("TextLabel")
        text.Size = UDim2.new(1, -220, 1, 0)
        text.BackgroundTransparency = 1
        text.Font = Enum.Font.GothamMedium
        text.TextSize = 12
        text.TextColor3 = C.text
        text.Text = labelText
        text.TextXAlignment = Enum.TextXAlignment.Left
        text.Parent = row
        local boxes = {}
        local names = {"R", "G", "B"}
        local value = cfg[key]
        for i, n in ipairs(names) do
            local box = Instance.new("TextBox")
            box.Position = UDim2.new(1, -210 + (i - 1) * 70, 0.5, -15)
            box.Size = UDim2.fromOffset(62, 30)
            box.BackgroundColor3 = C.panel3
            box.BorderSizePixel = 0
            box.ClearTextOnFocus = false
            box.Font = Enum.Font.GothamMedium
            box.TextSize = 11
            box.TextColor3 = C.text
            box.PlaceholderText = n
            box.Text = tostring(math.floor((value and value[string.lower(n)] or 0) * 255 + 0.5))
            box.Parent = row
            rounded(box, 7)
            stroke(box, C.border, 0.25)
            boxes[i] = box
        end
        local preview = Instance.new("Frame")
        preview.Position = UDim2.new(1, -246, 0.5, -10)
        preview.Size = UDim2.fromOffset(26, 20)
        preview.BorderSizePixel = 0
        preview.Parent = row
        rounded(preview, 6)

        local control = {kind = "color3", key = key, last = Color3.new(value.r, value.g, value.b)}
        function control:set(tbl)
            if type(tbl) ~= "table" then return end
            local col = Color3.new(math.clamp(tbl.r or 0, 0, 1), math.clamp(tbl.g or 0, 0, 1), math.clamp(tbl.b or 0, 0, 1))
            self.last = col
            local comps = {col.R, col.G, col.B}
            for i, box in ipairs(boxes) do box.Text = tostring(math.floor(comps[i] * 255 + 0.5)) end
            preview.BackgroundColor3 = col
        end
        controls[key] = control
        control:set(value)
        local function commit()
            local rgb = {}
            for i, box in ipairs(boxes) do rgb[i] = math.clamp(tonumber(box.Text) or 0, 0, 255) / 255 end
            local tbl = {r = rgb[1], g = rgb[2], b = rgb[3]}
            config:set(key, tbl)
            control:set(tbl)
        end
        for _, box in ipairs(boxes) do
            box.FocusLost:Connect(commit)
        end
        return control
    end

