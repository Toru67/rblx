
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- Rere UI library (keeps the original Rere window and tab system).
local Rere = assert((loadstring or load)(game:HttpGet("https://raw.githubusercontent.com/x8lua/Rere/main/src/Rere.lua")))()
Rere.Init()

local windowSize = Rere.State(Vector2.new(465, 420))
local windowOpened = Rere.State(true)
local tabStates = { Player = Rere.State(true), Visuals = Rere.State(false) }
local rereTabs = {}

local function createRereTab(name)
    local tab = { name = name, controls = {} }
    function tab:CreateCheckbox(label, callback, defaultValue)
        local initial = defaultValue == true
        local state = Rere.State(initial)
        table.insert(self.controls, { kind = "checkbox", label = label, callback = callback, state = state, last = initial })
        if callback then task.defer(function() pcall(callback, initial) end) end
    end
    function tab:CreateSlider(label, maxValue, defaultValue, callback)
        local state = Rere.State(defaultValue)
        table.insert(self.controls, { kind = "slider", label = label, callback = callback, state = state, last = defaultValue, max = maxValue, default = defaultValue })
        if callback then task.defer(function() pcall(callback, defaultValue) end) end
    end
    rereTabs[name] = tab
    return tab
end

local int = {}
function int:CreateTab(name) return createRereTab(name) end
local plr = int:CreateTab("Player")
local vis = int:CreateTab("Visuals")

-- Character / movement state
local character, humanoid, root
local flying = false
local cframeEnabled = false
local flySpeed = 50
local cframeSpeed = 32
local flightVelocity, flightGyro
local movementConnections = {}

local function bindCharacter(char)
    character = char
    humanoid = char:WaitForChild("Humanoid")
    root = char:WaitForChild("HumanoidRootPart")
end

local function clearFlightObjects()
    if flightVelocity then flightVelocity:Destroy(); flightVelocity = nil end
    if flightGyro then flightGyro:Destroy(); flightGyro = nil end
end

local function stopFlying()
    flying = false
    clearFlightObjects()
    if humanoid and humanoid.Parent then
        humanoid.PlatformStand = false
        pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
end

local function startFlying()
    if not humanoid or not root or humanoid.Health <= 0 then return end
    clearFlightObjects()
    flying = true
    humanoid.PlatformStand = true

    flightVelocity = Instance.new("BodyVelocity")
    flightVelocity.Name = "LocalFlightVelocity"
    flightVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    flightVelocity.P = 1e4
    flightVelocity.Velocity = Vector3.zero
    flightVelocity.Parent = root

    flightGyro = Instance.new("BodyGyro")
    flightGyro.Name = "LocalFlightGyro"
    flightGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    flightGyro.P = 1e4
    flightGyro.CFrame = root.CFrame
    flightGyro.Parent = root
end

local function setFlying(enabled)
    if enabled then startFlying() else stopFlying() end
end

plr:CreateCheckbox("Fly (WASD / Space / Ctrl) (keybind X)", setFlying)
plr:CreateCheckbox("CFrame Speed (keybind E)", function(enabled) cframeEnabled = enabled end)
plr:CreateSlider("CFrame Speed", 150, 32, function(value) cframeSpeed = math.clamp(value, 8, 150) end)
plr:CreateSlider("Fly Speed", 150, 50, function(value) flySpeed = math.clamp(value, 8, 150) end)

-- ESP state and cleanup
local playerESPEnabled = false
local playerESPObjects = {}
local playerESPConnections = {}
local npcESPEnabled = false
local npcESPObjects = {}
local npcTargetCache = {}
local npcScanBusy = false

local function isPlayerCharacter(model)
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character == model then return true end
    end
    return false
end

local function removeESP(objectsTable, target)
    local objects = objectsTable[target]
    if not objects then return end
    if objects.highlight then objects.highlight:Destroy() end
    if objects.billboard then objects.billboard:Destroy() end
    objectsTable[target] = nil
end

local function addESP(model, isNPC)
    local enabled = isNPC and npcESPEnabled or playerESPEnabled
    if not enabled or not model or not model:IsA("Model") then return end
    if isNPC and isPlayerCharacter(model) then return end

    local hum = model:FindFirstChildOfClass("Humanoid")
    local head = model:FindFirstChild("Head")
    if not hum or hum.Health <= 0 or not head or not head:IsA("BasePart") then
        if isNPC then removeESP(npcESPObjects, model) else
            local p = Players:GetPlayerFromCharacter(model)
            if p then removeESP(playerESPObjects, p) end
        end
        return
    end

    local key = isNPC and model or Players:GetPlayerFromCharacter(model)
    if not key then return end
    local tableRef = isNPC and npcESPObjects or playerESPObjects
    if tableRef[key] and tableRef[key].highlight and tableRef[key].highlight.Parent then return end
    removeESP(tableRef, key)

    local highlight = Instance.new("Highlight")
    highlight.Name = isNPC and "RereNPCESP" or "RerePlayerESP"
    highlight.Adornee = model
    highlight.FillColor = isNPC and Color3.fromRGB(255, 170, 0) or Color3.fromRGB(255, 0, 170)
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = 0.72
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = model

    local billboard = Instance.new("BillboardGui")
    billboard.Name = isNPC and "RereNPCLabel" or "RerePlayerLabel"
    billboard.Adornee = head
    billboard.Size = UDim2.fromOffset(200, 28)
    billboard.StudsOffset = Vector3.new(0, 2.6, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = model

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.Text = isNPC and (model.Name .. " [NPC]") or (key.DisplayName .. " (@" .. key.Name .. ")")
    label.TextSize = 12
    label.TextColor3 = isNPC and Color3.fromRGB(255, 190, 80) or Color3.fromRGB(255, 100, 210)
    label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.TextStrokeTransparency = 0.1
    label.Parent = billboard

    tableRef[key] = { highlight = highlight, billboard = billboard }
end

local function clearTable(tableRef)
    local keys = {}
    for key in pairs(tableRef) do table.insert(keys, key) end
    for _, key in ipairs(keys) do removeESP(tableRef, key) end
end

local function disconnectPlayerESP()
    for _, connection in ipairs(playerESPConnections) do
        if connection then connection:Disconnect() end
    end
    table.clear(playerESPConnections)
end

local function setupPlayerESP()
    disconnectPlayerESP()
    if not playerESPEnabled then clearTable(playerESPObjects); return end

    local function hookPlayer(targetPlayer)
        if targetPlayer == LocalPlayer then return end
        if targetPlayer.Character then addESP(targetPlayer.Character, false) end
        table.insert(playerESPConnections, targetPlayer.CharacterAdded:Connect(function(char)
            task.wait(0.5)
            if playerESPEnabled then addESP(char, false) end
        end))
    end

    for _, targetPlayer in ipairs(Players:GetPlayers()) do hookPlayer(targetPlayer) end
    table.insert(playerESPConnections, Players.PlayerAdded:Connect(hookPlayer))
    table.insert(playerESPConnections, Players.PlayerRemoving:Connect(function(targetPlayer)
        removeESP(playerESPObjects, targetPlayer)
    end))
end

vis:CreateCheckbox("Player ESP", function(enabled)
    playerESPEnabled = enabled
    setupPlayerESP()
end)

local function scanNPCs()
    if npcScanBusy then return end
    npcScanBusy = true
    local seen, targets = {}, {}
    for _, descendant in ipairs(Workspace:GetDescendants()) do
        if descendant:IsA("Model") and not isPlayerCharacter(descendant) then
            local hum = descendant:FindFirstChildOfClass("Humanoid")
            local head = descendant:FindFirstChild("Head")
            if hum and hum.Health > 0 and head and head:IsA("BasePart") then
                seen[descendant] = true
                table.insert(targets, descendant)
                if npcESPEnabled then addESP(descendant, true) end
            end
        end
    end
    npcTargetCache = targets
    for model in pairs(npcESPObjects) do
        if not model.Parent or not seen[model] then removeESP(npcESPObjects, model) end
    end
    npcScanBusy = false
end

vis:CreateCheckbox("NPC ESP (AI Humans)", function(enabled)
    npcESPEnabled = enabled
    if not enabled then clearTable(npcESPObjects) else task.spawn(scanNPCs) end
end)

task.spawn(function()
    while task.wait(1.5) do
        if npcESPEnabled then scanNPCs() end
    end
end)

-- Aim assist settings (hold right mouse button). Intended for controlled testing.
local aimbotEnabled = false
local aimbotFOV = 150
local aimSmoothing = 0.22
local aimHold = false
local fovGui, fovFrame

local function createFOVCircle()
    if fovGui then return end
    fovGui = Instance.new("ScreenGui")
    fovGui.Name = "RereAimFOV"
    fovGui.ResetOnSpawn = false
    fovGui.IgnoreGuiInset = true
    fovGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    fovFrame = Instance.new("Frame")
    fovFrame.Name = "FOVCircle"
    fovFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    fovFrame.BackgroundTransparency = 1
    fovFrame.BorderSizePixel = 0
    fovFrame.Size = UDim2.fromOffset(aimbotFOV * 2, aimbotFOV * 2)
    fovFrame.Visible = false
    fovFrame.Parent = fovGui
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = fovFrame
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 70, 170)
    stroke.Thickness = 2
    stroke.Parent = fovFrame
end

local function updateFOVCircle()
    Camera = Workspace.CurrentCamera
    if not Camera then return end
    createFOVCircle()
    local center = Camera.ViewportSize / 2
    fovFrame.Position = UDim2.fromOffset(center.X, center.Y)
    fovFrame.Size = UDim2.fromOffset(aimbotFOV * 2, aimbotFOV * 2)
    fovFrame.Visible = aimbotEnabled
end

plr:CreateCheckbox("Aimbot (hold RMB)", function(enabled)
    aimbotEnabled = enabled
    updateFOVCircle()
end)
plr:CreateSlider("Aim Assist FOV", 500, 150, function(value) aimbotFOV = math.max(10, value) end)
plr:CreateSlider("Aim Smoothness %", 100, 22, function(value) aimSmoothing = math.clamp(value / 100, 0.03, 1) end)

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then aimHold = true end
    if input.KeyCode == Enum.KeyCode.X then setFlying(not flying) end
    if input.KeyCode == Enum.KeyCode.E then cframeEnabled = not cframeEnabled end
    if input.KeyCode == Enum.KeyCode.K then windowOpened:set(not windowOpened:get()) end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then aimHold = false end
end)

local function renderRereUI()
    Rere.Window({ "by Toru", false, false, false, false }, { size = windowSize, isOpened = windowOpened })
    Rere.TabBar()
    for _, name in ipairs({ "Player", "Visuals" }) do
        local tab = rereTabs[name]
        Rere.Tab({ name }, { isOpened = tabStates[name] })
        Rere.Separator()
        for _, control in ipairs(tab.controls) do
            if control.kind == "checkbox" then
                Rere.Checkbox({ control.label }, { isChecked = control.state })
                local value = control.state:get()
                if value ~= control.last then
                    control.last = value
                    if control.callback then pcall(control.callback, value) end
                end
            elseif control.kind == "slider" then
                local minValue = control.max == 500 and 10 or 1
                local format = control.max == 500 and "%d px" or "%d"
                Rere.SliderNum({ control.label, minValue, control.default, control.max, format }, { number = control.state })
                local value = control.state:get()
                if value ~= control.last then
                    control.last = value
                    if control.callback then pcall(control.callback, value) end
                end
            end
        end
        Rere.End()
    end
    Rere.End()
    Rere.End()
end

bindCharacter(LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait())
LocalPlayer.CharacterAdded:Connect(function(char)
    stopFlying()
    cframeEnabled = false
    bindCharacter(char)
    task.wait(0.5)
    if playerESPEnabled then setupPlayerESP() end
end)

local rereAlive = true
local rereConnection = Rere:Connect(function()
    if rereAlive then renderRereUI() end
end)

local renderConnection = RunService.RenderStepped:Connect(function(dt)
    if not character or not humanoid or not root or humanoid.Health <= 0 then return end
    Camera = Workspace.CurrentCamera

    if flying and flightVelocity and flightGyro and Camera then
        local move = Vector3.zero
        local forward = Camera.CFrame.LookVector
        local right = Camera.CFrame.RightVector
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += forward end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= forward end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += right end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= right end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.yAxis end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.C) then move -= Vector3.yAxis end
        flightVelocity.Velocity = move.Magnitude > 0 and move.Unit * flySpeed or Vector3.zero
        flightGyro.CFrame = Camera.CFrame
    elseif cframeEnabled and not flying and humanoid.MoveDirection.Magnitude > 0 then
        root.CFrame = root.CFrame + humanoid.MoveDirection * cframeSpeed * dt
    end

    updateFOVCircle()
    if not aimbotEnabled or not aimHold or not Camera then return end
    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
    local bestHead, bestDistance = nil, aimbotFOV
    local candidates = {}
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= LocalPlayer and targetPlayer.Character then table.insert(candidates, targetPlayer.Character) end
    end
    for _, npc in ipairs(npcTargetCache) do if npc.Parent then table.insert(candidates, npc) end end
    for _, model in ipairs(candidates) do
        local hum = model:FindFirstChildOfClass("Humanoid")
        local head = model:FindFirstChild("Head")
        if head and head:IsA("BasePart") and hum and hum.Health > 0 then
            local point, onScreen = Camera:WorldToViewportPoint(head.Position)
            if onScreen and point.Z > 0 then
                local distance = (Vector2.new(point.X, point.Y) - center).Magnitude
                if distance < bestDistance then bestDistance, bestHead = distance, head end
            end
        end
    end
    if bestHead then
        local desired = CFrame.lookAt(Camera.CFrame.Position, bestHead.Position)
        Camera.CFrame = Camera.CFrame:Lerp(desired, aimSmoothing)
    end
end)

script.Destroying:Connect(function()
    rereAlive = false
    stopFlying()
    if renderConnection then renderConnection:Disconnect() end
    if rereConnection and rereConnection.Disconnect then rereConnection:Disconnect() end
    disconnectPlayerESP()
    clearTable(playerESPObjects)
    clearTable(npcESPObjects)
    if fovGui then fovGui:Destroy() end
end)
