local function startLoop(name, fn)
    loops[name] = true
    task.spawn(function()
        while loops[name] do
            pcall(fn)
            task.wait(1)
        end
    end)
end

local function guiVisible(obj)
    while obj and not obj:IsA("ScreenGui") do
        if obj:IsA("GuiObject") and not obj.Visible then return false end
        obj = obj.Parent
    end
    if obj and obj:IsA("ScreenGui") and not obj.Enabled then return false end
    return true
end

local function isGold(color)
    return color.R > 0.7 and color.G > 0.45 and color.B < 0.6 and (color.R - color.B) > 0.25
end

local function goldOn(obj)
    if obj.BackgroundTransparency < 1 and isGold(obj.BackgroundColor3) then return true end
    if (obj:IsA("ImageLabel") or obj:IsA("ImageButton"))
        and obj.Image ~= "" and obj.ImageTransparency < 1 and isGold(obj.ImageColor3) then
        return true
    end
    for _, ch in ipairs(obj:GetChildren()) do
        if ch:IsA("UIStroke") and ch.Transparency < 1 and isGold(ch.Color) then return true end
    end
    return false
end

local function pressKey(key)
    pcall(function() vim:SendKeyEvent(true, key, false, game) end)
    task.wait(0.05)
    pcall(function() vim:SendKeyEvent(false, key, false, game) end)
end

local function holdKey(key, seconds)
    pcall(function() vim:SendKeyEvent(true, key, false, game) end)
    task.wait(seconds)
    pcall(function() vim:SendKeyEvent(false, key, false, game) end)
end

local function dumpTree(root)
    local function dump(obj, indent)
        local extra = ""
        if obj:IsA("ProximityPrompt") then
            extra = " Enabled=" .. tostring(obj.Enabled) .. " Key=" .. obj.KeyboardKeyCode.Name
        elseif obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            extra = " Text='" .. obj.Text .. "'"
        elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
            extra = " Vis=" .. tostring(obj.Visible) .. " Size=" .. tostring(obj.AbsoluteSize)
                .. " Img=" .. obj.Image .. " ImgColor=" .. tostring(obj.ImageColor3)
        elseif obj:IsA("GuiObject") then
            extra = " Vis=" .. tostring(obj.Visible) .. " Size=" .. tostring(obj.AbsoluteSize)
                .. " Color=" .. tostring(obj.BackgroundColor3) .. " BgTrans=" .. tostring(obj.BackgroundTransparency)
        elseif obj:IsA("UIStroke") then
            extra = " Color=" .. tostring(obj.Color) .. " Trans=" .. tostring(obj.Transparency)
        elseif obj:IsA("ScreenGui") then
            extra = " Enabled=" .. tostring(obj.Enabled)
        end
        print(string.rep("  ", indent) .. obj.Name .. " [" .. obj.ClassName .. "]" .. extra)
        for _, c in ipairs(obj:GetChildren()) do dump(c, indent + 1) end
    end
    dump(root, 0)
end

-- Auto Perfect: Body Trial ring shrinks onto the letter circle; press when gold/converged.
local promptState = {}
local accumulator = 0
local dumped = false

runService.Heartbeat:Connect(function(dt)
    if not loops.Perfect then return end
    accumulator += dt
    if accumulator < 1 / 60 then return end
    accumulator = 0

    local ok, err = pcall(function()
        local playerGui = player:FindFirstChildOfClass("PlayerGui")
        local trial = playerGui and playerGui:FindFirstChild("BodyTrialGui", true)
        if not trial or not guiVisible(trial) then
            perfectStatus = "Waiting for Body Trial"
            table.clear(promptState)
            dumped = false
            return
        end
        if not dumped then
            dumped = true
            print("[Larpshin] BodyTrialGui dump:")
            pcall(dumpTree, trial)
        end

        local trap = trial:FindFirstChild("TrialKeyTrap", true)
        local seen = {}

        for _, prompt in ipairs(trial:GetChildren()) do
            if not prompt.Name:match("^Prompt") then continue end

            if prompt:IsA("ProximityPrompt") then
                seen[#seen + 1] = prompt.Name .. ":ProximityPrompt"
                if prompt.Enabled then
                    local state = promptState[prompt]
                    if not state then
                        state = {Pressed = false}
                        promptState[prompt] = state
                    end
                    if not state.Pressed then
                        state.Pressed = true
                        local key = prompt.KeyboardKeyCode
                        perfectStatus = "Hitting " .. key.Name
                        task.delay(math.max(0, perfectOffsetMs.value / 1000), function()
                            if not loops.Perfect or not prompt.Enabled then return end
                            if type(fireproximityprompt) == "function" then
                                pcall(fireproximityprompt, prompt)
                            else
                                pressKey(key)
                            end
                        end)
                    end
                else
                    promptState[prompt] = nil
                end

            elseif prompt:IsA("GuiObject") then
                seen[#seen + 1] = prompt.Name .. ":" .. prompt.ClassName
                if not guiVisible(prompt) then
                    promptState[prompt] = nil
                else
                    local letter, letterObj
                    local squares = {}
                    local function scan(obj)
                        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                            local t = tostring(obj.Text):match("^%s*(%a)%s*$")
                            if t and not letterObj then letter, letterObj = t:upper(), obj end
                        end
                        if obj:IsA("GuiObject") and obj.Visible then
                            local s = obj.AbsoluteSize
                            if s.X > 20 and math.abs(s.X - s.Y) / s.X < 0.25 then
                                squares[#squares + 1] = obj
                            end
                        end
                    end
                    scan(prompt)
                    for _, d in ipairs(prompt:GetDescendants()) do scan(d) end

                    if letter and letterObj and #squares > 0 then
                        local state = promptState[prompt]
                        if not state or state.Letter ~= letter then
                            state = {Letter = letter, Pressed = false, Sizes = {}}
                            promptState[prompt] = state
                        end

                        local circle
                        for _, sq in ipairs(squares) do
                            if sq ~= letterObj and letterObj:IsDescendantOf(sq) then
                                if not circle or sq.AbsoluteSize.X < circle.AbsoluteSize.X then circle = sq end
                            end
                        end
                        if not circle then
                            for _, sq in ipairs(squares) do
                                if sq ~= letterObj and (not circle or sq.AbsoluteSize.X < circle.AbsoluteSize.X) then circle = sq end
                            end
                        end

                        local ring, shrinking
                        for _, sq in ipairs(squares) do
                            if sq ~= circle and sq ~= letterObj and not letterObj:IsDescendantOf(sq) then
                                local last = state.Sizes[sq]
                                state.Sizes[sq] = sq.AbsoluteSize.X
                                if last and sq.AbsoluteSize.X < last - 0.5 then shrinking = sq end
                                if not ring or sq.AbsoluteSize.X > ring.AbsoluteSize.X then ring = sq end
                            end
                        end
                        ring = shrinking or ring

                        local ready = false
                        if ring then
                            if goldOn(ring) then ready = true end
                            if circle and ring.AbsoluteSize.X <= circle.AbsoluteSize.X * 1.15 then ready = true end
                        end

                        if ready and not state.Pressed then
                            state.Pressed = true
                            local key = Enum.KeyCode[letter]
                            if key then
                                perfectStatus = "Hitting " .. letter
                                task.delay(math.max(0, perfectOffsetMs.value / 1000), function()
                                    if not loops.Perfect or not guiVisible(prompt) then return end
                                    if trap and trap:IsA("TextBox") and not trap:IsFocused() then
                                        pcall(function() trap:CaptureFocus() end)
                                    end
                                    pressKey(key)
                                end)
                            end
                        end
                    end
                end
            else
                seen[#seen + 1] = prompt.Name .. ":" .. prompt.ClassName
            end
        end

        if #seen == 0 then
            perfectStatus = "Trial open - no Prompt children found"
        elseif not perfectStatus:match("^Hitting") then
            perfectStatus = "Watching " .. table.concat(seen, ", ")
        end
    end)
    if not ok then perfectStatus = "Error: " .. tostring(err) end
end)

-- Herb Farm: dropdown from Workspace.HerbSpots, walk to spots, pick up with E.
local herbNames = {}
local herbIndex = Rere.State(nil)

local function findHerbFolder()
    return workspace:FindFirstChild("HerbSpots") or workspace:FindFirstChild("HerbSpots", true)
end

local function refreshHerbs()
    local folder = findHerbFolder()
    local set, list = {}, {}
    if folder then
        for _, c in ipairs(folder:GetChildren()) do
            if not set[c.Name] then
                set[c.Name] = true
                list[#list + 1] = c.Name
            end
        end
    end
    table.sort(list)
    herbNames = list
    if not herbIndex.value or not set[herbIndex.value] then herbIndex.value = list[1] end
end

local function herbPosition(obj)
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart.Position end
        local ok, cf = pcall(function() return obj:GetBoundingBox() end)
        if ok then return cf.Position end
    end
    local part = obj:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position
end

local function walkTo(pos)
    local deadline = os.clock() + 25
    local lastDist, stuckAt = math.huge, os.clock()
    while os.clock() < deadline and (loops.Herbs or loops.Chests) do
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp or hum.Health <= 0 then return false end
        local dist = (hrp.Position - pos).Magnitude
        if dist <= 3.5 then return true end
        if dist < lastDist - 0.25 then
            lastDist = dist
            stuckAt = os.clock()
        elseif os.clock() - stuckAt > 2.5 then
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
            stuckAt = os.clock()
        end
        pcall(function() hum:MoveTo(pos) end)
        task.wait(0.4)
    end
    return false
end

local function interactWith(obj)
    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and type(fireproximityprompt) == "function" then
        pcall(fireproximityprompt, prompt)
    elseif prompt then
        holdKey(Enum.KeyCode.E, math.max(0.1, prompt.HoldDuration) + 0.15)
    else
        holdKey(Enum.KeyCode.E, 0.12)
    end
    task.wait(0.4)
end

-- No Clip + WalkSpeed boost, active while herb farming.
local noClipEnabled = false
local noClipOriginal = {}
local cframeBoost = false
local farmSpeed = Rere.State(30)
local originalWalkSpeed = nil

local function restoreNoClip()
    for part, original in pairs(noClipOriginal) do
        if part and part.Parent then
            pcall(function() part.CanCollide = original end)
        end
    end
    table.clear(noClipOriginal)
end

local function restoreWalkSpeed()
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and originalWalkSpeed then
        pcall(function() hum.WalkSpeed = originalWalkSpeed end)
    end
    originalWalkSpeed = nil
end

local function syncMovement()
    local on = loops.Herbs or loops.Chests
    if on and not noClipEnabled then
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        originalWalkSpeed = hum and hum.WalkSpeed or 16
    end
    noClipEnabled = on
    cframeBoost = on
    if not on then restoreWalkSpeed() end
end

runService.Heartbeat:Connect(function(dt)
    if noClipEnabled then
        local char = player.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    if noClipOriginal[part] == nil then noClipOriginal[part] = part.CanCollide end
                    if part.CanCollide then part.CanCollide = false end
                end
            end
        end
    elseif next(noClipOriginal) ~= nil then
        restoreNoClip()
    end

    if cframeBoost then
        local speed = math.clamp(farmSpeed.value, 0, 100)
        if speed > 0 then
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.WalkSpeed ~= speed then
                pcall(function() hum.WalkSpeed = speed end)
            end
        end
    end
end)

local function startHerbFarm()
    loops.Herbs = true
    syncMovement()
    task.spawn(function()
        while loops.Herbs do
            local folder = findHerbFolder()
            local selected = herbIndex.value
            if not folder or not selected then
                herbStatus = "Waiting for HerbSpots / selection"
                task.wait(1)
            else
                local targets = {}
                for _, c in ipairs(folder:GetChildren()) do
                    if c.Name == selected then targets[#targets + 1] = c end
                end
                if #targets == 0 then
                    herbStatus = "No '" .. selected .. "' spots - waiting"
                    task.wait(1)
                else
                    for _, obj in ipairs(targets) do
                        if not loops.Herbs then break end
                        if not obj.Parent then continue end
                        local pos = herbPosition(obj)
                        if pos then
                            herbStatus = "Walking to " .. selected
                            if walkTo(pos) then
                                herbStatus = "Picking " .. selected
                                interactWith(obj)
                            else
                                herbStatus = "Could not reach " .. selected
                            end
                        end
                    end
                    task.wait(0.5)
                end
            end
        end
        syncMovement()
        herbStatus = "Off"
    end)
end

-- Chest Farm: walk to every chest in Workspace.ChestSpots and open its prompt.
local function findChestFolder()
    return workspace:FindFirstChild("ChestSpots") or workspace:FindFirstChild("ChestSpots", true)
end

local function startChestFarm()
    loops.Chests = true
    syncMovement()
    task.spawn(function()
        while loops.Chests do
            local folder = findChestFolder()
            if not folder then
                chestStatus = "Waiting for ChestSpots"
                task.wait(1)
            else
                local chests = folder:GetChildren()
                if #chests == 0 then
                    chestStatus = "No chests in ChestSpots"
                    task.wait(1)
                else
                    for _, chest in ipairs(chests) do
                        if not loops.Chests then break end
                        if not chest.Parent then continue end
                        local prompt = chest:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt and not prompt.Enabled then
                            chestStatus = chest.Name .. " on cooldown"
                            continue
                        end
                        local pos = herbPosition(chest)
                        if pos then
                            chestStatus = "Walking to " .. chest.Name
                            if walkTo(pos) then
                                chestStatus = "Opening " .. chest.Name
                                interactWith(chest)
                                task.wait(0.3)
                            else
                                chestStatus = "Could not reach " .. chest.Name
                            end
                        end
                    end
                    task.wait(1)
                end
            end
        end
        syncMovement()
        chestStatus = "Off"
    end)
end

-- Instant Prompts: HoldDuration 0 on all current and future ProximityPrompts.
local instantPrompts = false
local instantConn = nil

local function applyInstant(obj)
    if obj:IsA("ProximityPrompt") then
        pcall(function() obj.HoldDuration = 0 end)
    end
end

local function setInstantPrompts(on)
    instantPrompts = on
    if on then
        for _, v in ipairs(workspace:GetDescendants()) do applyInstant(v) end
        if not instantConn then
            instantConn = workspace.DescendantAdded:Connect(applyInstant)
        end
    elseif instantConn then
        instantConn:Disconnect()
        instantConn = nil
    end
end

-- Auto Fight: teleport behind the nearest tagged NPC, spam right click, keep repositioning.
local fightTag = "Bandit"

local function findTarget(tag)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local candidates = collectionService:GetTagged(tag)
    if #candidates == 0 then
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("Model") and d.Name == tag then candidates[#candidates + 1] = d end
        end
    end
    local best, bestDist
    for _, inst in ipairs(candidates) do
        local model = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
        if model then
            local hum = model:FindFirstChildOfClass("Humanoid")
            local part = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart")
            if hum and hum.Health > 0 and part then
                local d = (part.Position - hrp.Position).Magnitude
                if not bestDist or d < bestDist then best, bestDist = model, d end
            end
        end
    end
    return best
end

local function startFight(tag)
    loops.Fight = true
    fightTag = tag
    fightStatus = "Fighting " .. tag
    task.spawn(function()
        while loops.Fight do
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hum or not hrp or hum.Health <= 0 then
                fightStatus = "Dead - waiting for respawn"
                task.wait(1)
            else
                local target = findTarget(fightTag)
                if not target then
                    fightStatus = "No " .. fightTag .. " found - waiting"
                    task.wait(1)
                else
                    local ehum = target:FindFirstChildOfClass("Humanoid")
                    local ehrp = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChildWhichIsA("BasePart")
                    if ehum and ehum.Health > 0 and ehrp then
                        local behind = ehrp.Position - ehrp.CFrame.LookVector * 3
                        pcall(function()
                            hrp.CFrame = CFrame.new(behind, ehrp.Position)
                            hrp.AssemblyLinearVelocity = Vector3.zero
                        end)
                        local cam = workspace.CurrentCamera
                        if cam then
                            pcall(function()
                                cam.CFrame = CFrame.new(cam.CFrame.Position, ehrp.Position)
                            end)
                            local vp = cam.ViewportSize
                            pcall(function()
                                vim:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 1, true, game, 0)
                                vim:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 1, false, game, 0)
                            end)
                        end
                        fightStatus = "Fighting " .. fightTag .. " (" .. math.floor(ehum.Health) .. " HP)"
                    end
                    task.wait(0.15)
                end
            end
        end
        fightStatus = "Off"
    end)
end

