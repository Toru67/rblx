    end
    for _, v in ipairs(player:GetChildren()) do
        if v:IsA("IntValue") or v:IsA("NumberValue") then
            local k = v.Name:lower()
            if k:find("realm") or k:find("level") or k:find("lvl") then
                return v.Value, "player." .. v.Name
            end
        end
    end
    for _, key in ipairs({"Realm", "realm", "Level", "level"}) do
        local a = player:GetAttribute(key)
        if type(a) == "number" then return a, "attribute " .. key end
    end
    return nil, "unknown"
end

local function questStatusOf(id)
    local s = questState[id]
    local entry = nil
    if type(s) == "table" then
        entry = s
        s = s.status or s.state or (s.active and "active") or nil
        if s == nil and entry.completed == true then s = "completed" end
        if type(s) == "string" and s:lower() == "active" and type(entry.progress) == "number" then
            local def = QUESTS[id]
            if def and def.requiredCount and entry.progress >= def.requiredCount then
                s = "completed"
            end
        end
    end
    if type(s) ~= "string" then return nil, entry end
    s = s:lower()
    if s == "complete" or s == "done" or s == "finished" or s == "ready" or s == "turnin" or s == "claim" then
        s = "completed"
    end
    return s, entry
end

local function absorb(payload, depth)
    if type(payload) ~= "table" or depth > 3 then return end
    for k, v in pairs(payload) do
        if type(k) == "string" then
            local lk = k:lower()
            if (lk == "realm" or lk == "playerrealm" or lk == "currentrealm") and type(v) == "number" then
                remoteRealm = v
            end
            if QUESTS[k] then
                questState[k] = v
            elseif k:lower() == "quests" and type(v) == "table" then
                for qk, qv in pairs(v) do
                    if QUESTS[qk] then questState[qk] = qv end
                end
            end
        end
        if type(v) == "table" then
            if type(v.id) == "string" and QUESTS[v.id] then
                questState[v.id] = v
            end
            absorb(v, depth + 1)
        end
    end
end

local function dumpPayload(tag, payload)
    if questDumped[tag] then return end
    questDumped[tag] = true
    local ok, json = pcall(function()
        return game:GetService("HttpService"):JSONEncode(payload)
    end)
    if ok then
        print("[Larpshin] " .. tag .. " payload: " .. json:sub(1, 1500))
    else
        print("[Larpshin] " .. tag .. " payload: (unencodable) " .. tostring(payload))
    end
end

local function questRemote(name)
    return events:FindFirstChild(name)
end

local function requestQuestData()
    for _, name in ipairs({"RequestQuestData", "RequestQuestState"}) do
        local r = questRemote(name)
        if r then
            task.spawn(function()
                local ok, res = pcall(function()
                    if r:IsA("RemoteFunction") then return r:InvokeServer() end
                    r:FireServer()
                    return nil
                end)
                if ok and res ~= nil then
                    absorb(res, 0)
                    dumpPayload(name, res)
                end
            end)
        end
    end
end

for _, name in ipairs({"QuestDataUpdate", "QuestProgressUpdate", "QuestUnlocked"}) do
    local r = questRemote(name)
    if r and r:IsA("RemoteEvent") then
        r.OnClientEvent:Connect(function(...)
            local args = {...}
            for _, a in ipairs(args) do absorb(a, 0) end
            dumpPayload(name, args)
        end)
    end
end
