local function questVisible(id)
    local def = QUESTS[id]
    return def and (not def.hidden or questState[id] ~= nil)
end

local function questOptions()
    local list = {NONE}
    for _, id in ipairs(ORDER) do
        if questVisible(id) then list[#list + 1] = QUESTS[id].name end
    end
    return list
end

local function questRow(id, realm)
    local def = QUESTS[id]
    if not def or not questVisible(id) then return nil end
    local status, entry = questStatusOf(id)
    local req = def.requiredRealm or 1
    if status == "active" then
        local label = def.name .. ": Active"
        if entry and type(entry.progress) == "number" then
            label = label .. string.format(" (%d/%d)", entry.progress, def.requiredCount or 0)
        end
        return label, GREEN
    elseif status == "completed" then
        return def.name .. ": Completed", GREY
    elseif realm and realm < req then
        return def.name .. ": Realm " .. req .. "+", RED
    else
        return def.name .. ": Eligible" .. (isManual(def) and " (manual)" or ""), GREEN
    end
end

local function fireAccept(id)
    local r = questRemote("AcceptQuest")
    if not r then
        questStatus = "AcceptQuest remote missing"
        print("[Larpshin] AcceptQuest remote not found in CultivationEvents")
        return
    end
    local ok, res = pcall(function()
        if r:IsA("RemoteFunction") then return r:InvokeServer(id) end
        r:FireServer(id)
        return nil
    end)
    if not ok then
        questStatus = "Accept error: " .. tostring(res)
        print("[Larpshin] AcceptQuest error: " .. tostring(res))
    else
        questStatus = "Accepting " .. QUESTS[id].name
        print("[Larpshin] AcceptQuest -> " .. id)
        if res ~= nil then
            absorb(res, 0)
            dumpPayload("AcceptQuest", res)
        end
    end
end

local function findGiverPart(giverName)
    local tries = {giverName, giverName:gsub(" ", ""), giverName:gsub(" ", "_")}
    for _, name in ipairs(tries) do
        local obj = workspace:FindFirstChild(name, true)
        if obj then
            if obj:IsA("BasePart") then return obj end
            local part = obj:FindFirstChildWhichIsA("BasePart", true)
            if part then return part end
        end
    end
    return nil
end

local function turnInQuest(id)
    local def = QUESTS[id]
    local giver = def.giverName or ""
    questStatus = "Turning in " .. def.name
    print("[Larpshin] turn-in -> " .. id .. " (" .. giver .. ")")
    local part = findGiverPart(giver)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if part and hrp then
        pcall(function()
            hrp.CFrame = CFrame.new(part.Position + part.CFrame.LookVector * 3 + Vector3.new(0, 1, 0), part.Position)
            hrp.AssemblyLinearVelocity = Vector3.zero
        end)
        task.wait(0.3)
    end
    local open = questRemote("OpenQuestGiver")
    if open then
        pcall(function()
            if open:IsA("RemoteFunction") then open:InvokeServer(id) else open:FireServer(id) end
        end)
        pcall(function()
            if open:IsA("RemoteFunction") then open:InvokeServer(giver) else open:FireServer(giver) end
        end)
        task.wait(0.3)
    end
    fireAccept(id)
end

local lastAccept = {}
local questDriven = {Qi = false, Herbs = false, Fight = false}
local prevAuto = false

task.spawn(function()
    while true do
        task.wait(1)
        local on = autoQuest.value
        if on ~= prevAuto then
            prevAuto = on
            if on then
                questStatus = "Running"
                requestQuestData()
            else
                if questDriven.Qi then loops.Qi = false; questDriven.Qi = false end
                if questDriven.Herbs then
                    loops.Herbs = false
                    questDriven.Herbs = false
                    syncMovement()
                end
                if questDriven.Fight then loops.Fight = false; questDriven.Fight = false end
                questStatus = "Off"
            end
        end
        if on then
            local realm = currentRealm()
            local picked = questPick.value
            local combatActive = false
            for _, id in ipairs(ORDER) do
                local def = QUESTS[id]
                if def and questVisible(id) and (picked == NONE or def.name == picked) then
                    local status = questStatusOf(id)
                    local req = def.requiredRealm or 1
                    if status == "active" then
                        if def.objectiveType == "meditate" and not loops.Qi then
                            questDriven.Qi = true
                            startLoop("Qi", function() events.StartMeditate:FireServer() end)
                        elseif def.objectiveType == "collect" and def.targetTag == "Herb" and not loops.Herbs then
                            refreshHerbs()
                            if #herbNames > 0 then
                                herbIndex.value = herbNames[1]
                                questDriven.Herbs = true
                                startHerbFarm()
                            end
                        elseif def.objectiveType == "kill" or def.objectiveType == "boss" then
                            combatActive = true
                            if not loops.Fight then
                                questDriven.Fight = true
                                startFight(def.targetTag or "Bandit")
                            end
                        end
                    elseif status == "completed" then
                        if lastAccept[id] == nil or os.clock() - lastAccept[id] > 3 then
                            lastAccept[id] = os.clock()
                            turnInQuest(id)
                        end
                    elseif (realm == nil or realm >= req)
                        and (lastAccept[id] == nil or os.clock() - lastAccept[id] > 10) then
                        lastAccept[id] = os.clock()
                        fireAccept(id)
                    end
                end
            end
            if questDriven.Fight and not combatActive then
                loops.Fight = false
                questDriven.Fight = false
            end
        end
    end
end)

