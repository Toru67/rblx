local function inferMovedColor(previousBoard, currentBoard)

    if not previousBoard or not currentBoard then

        return nil

    end



    local changes = {

        [true] = 0,

        [false] = 0

    }



    for r = 1, 8 do

        for f = 1, 8 do

            local oldPiece = previousBoard[r][f]

            local newPiece = currentBoard[r][f]



            local samePiece = oldPiece and newPiece

                and oldPiece.t == newPiece.t

                and oldPiece.c == newPiece.c



            if not samePiece then

                if oldPiece then

                    changes[oldPiece.c] = changes[oldPiece.c] + 1

                end



                if newPiece then

                    changes[newPiece.c] = changes[newPiece.c] + 1

                end

            end

        end

    end



    if changes[true] > changes[false] then

        return true

    elseif changes[false] > changes[true] then

        return false

    end



    return nil

end





local function calculate()



    if not SelectedColor then



        if SelectedColor == false then



            -- BLACK is a valid selection.*



        else



            return



        end



    end







    CurrentBoard = getNearestBoard()







    if not CurrentBoard then



