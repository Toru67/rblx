    if not board then



        Status.Text = "Could not scan board"



        return



    end







    local currentFingerprint = fingerprint(board)



    if currentFingerprint == LastPosition then

        return

    end



    local movedColor = inferMovedColor(LastObservedBoard, board)

    LastObservedBoard = cloneBoard(board)

    LastPosition = currentFingerprint



    -- On first scan, calculate a move so the player can make the opening move.*

    -- After that, only calculate again when the opponent has moved.*

    if movedColor ~= nil and movedColor == SelectedColor then

        SuggestedMove = nil

        clearHighlights()

        Status.Text = "Your move detected - waiting for opponent..."

        return

    end



    SuggestedMove = nil

    clearHighlights()



    Status.Text = "Opponent moved - calculating best move..."







    task.spawn(function()



        local move = bestMove(board, SelectedColor)







        if not Running or not move then



            Status.Text = "No legal moves"



            return



        end







        local latestBoard = scanBoard(CurrentBoard)







        if not latestBoard or fingerprint(latestBoard) ~= currentFingerprint then



            Status.Text = "Board changed - rescanning"



            return



        end







        SuggestedMove = move



        highlightMove(board, grid, move)







        local from = squareName(move.fr, move.ff)



        local to = squareName(move.toR, move.toF)







        if move.capture then



            Status.Text = "CAPTURE: " .. from .. " -> " .. to



        elseif move.givesCheck then



            Status.Text = "CHECK: " .. from .. " -> " .. to



        else



            Status.Text = "BEST MOVE: " .. from .. " -> " .. to



        end



    end)



end







