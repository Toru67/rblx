local function getNearestBoard()



    local character = Player.Character



    local root = character and character:FindFirstChild("HumanoidRootPart")







    if not root then



        return nil



    end







    local nearest



    local nearestDistance = math.huge







    for i = 1, 18 do



        local board = ROOT:FindFirstChild("Chess_" .. i)







        if board then



            local chessBoard = board:FindFirstChild("ChessBoard")



            local grid = chessBoard



                and chessBoard:FindFirstChild("Board")



                and chessBoard.Board:FindFirstChild("_ChessGridAnchor")







            if grid then



                local distance = (root.Position - grid.Position).Magnitude







                if distance < nearestDistance then



                    nearestDistance = distance



                    nearest = chessBoard



                end



            end



        end



    end







    return nearest



end







local function scanBoard(chessBoard)



    local grid = chessBoard



        and chessBoard:FindFirstChild("Board")



        and chessBoard.Board:FindFirstChild("_ChessGridAnchor")







    if not grid then



        return nil



    end







    local board = {}







    for r = 1, 8 do



        board[r] = {}







        for f = 1, 8 do



            board[r][f] = nil



        end



    end







    local cell = grid.Size.X / 8







    local function scanFolder(folder, color)



        if not folder then



            return



        end







        for _, piece in ipairs(folder:GetChildren()) do



            if piece:IsA("BasePart") then



                local pieceType







                for name, symbol in pairs(PieceTypes) do



                    if string.find(piece.Name, name) then



                        pieceType = symbol



                        break



                    end



                end







                if pieceType then



                    local localPosition =



                        grid.CFrame:PointToObjectSpace(piece.Position)







                    local file = math.floor(



                        (localPosition.X + grid.Size.X / 2) / cell



                    ) + 1







                    local rank = 8 - math.floor(



                        (localPosition.Z + grid.Size.Z / 2) / cell



                    )







                    if inside(rank, file) then



                        board[rank][file] = {



                            t = pieceType,



                            c = color,



                            part = piece



                        }



                    end



                end



            end



        end



    end







    scanFolder(chessBoard:FindFirstChild("WhiteFigures"), true)



    scanFolder(chessBoard:FindFirstChild("BlackFigures"), false)







    return board, grid



end







local function fingerprint(board)



    local parts = {}







    for r = 1, 8 do



        for f = 1, 8 do



            local p = board[r][f]







            if p then



                parts[#parts + 1] =



                    tostring(r) .. tostring(f) .. p.t .. (p.c and "w" or "b")



            else



                parts[#parts + 1] = "."



            end



        end



    end







    return table.concat(parts)



end







